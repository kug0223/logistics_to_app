rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // 헬퍼 함수
    // ═══════════════════════════════════════════════════════════

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isLoggedIn() && myRole() == 'SUPER_ADMIN';
    }

    function isBusinessAdmin() {
      return isLoggedIn() && myRole() == 'BUSINESS_ADMIN';
    }

    function isUser() {
      return isLoggedIn() && myRole() == 'USER';
    }

    function isAdmin() {
      return isLoggedIn() && (myRole() == 'SUPER_ADMIN' || myRole() == 'BUSINESS_ADMIN');
    }

    // 특정 사업장의 adminIds에 포함된 관리자인지 확인 (슈퍼관리자 포함 아님 — 별도 || isSuperAdmin() 사용)
    // adminIds 필드가 없는 기존 문서는 ownerId로 폴백
    function isAdminOf(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return isLoggedIn() && (
        ('adminIds' in biz && request.auth.uid in biz.adminIds) ||
        (!('adminIds' in biz) && biz.ownerId == request.auth.uid)
      );
    }

    // ═══════════════════════════════════════════════════════════
    // users 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {

      // 직접 문서 읽기 (GET by UID): 반드시 로그인 필요
      // 기존 || request.query.limit <= 1 제거 → 비로그인 직접 열람 차단
      allow get: if isLoggedIn() && (
                    isOwner(userId) ||
                    isSuperAdmin() ||
                    isBusinessAdmin()
                  );

      // 쿼리 (LIST): 로그인 전 username 검색 허용
      // - 로그인 화면: username → email 조회 (limit 1)
      // - 아이디 찾기: name + phone 조회 (limit 1)
      // - 회원가입 중복 체크: username 조회 (limit 1)
      // limit(1) 제한으로 대량 수집 방지
      allow list: if request.query.limit <= 1 ||
                   (isLoggedIn() && (isSuperAdmin() || isBusinessAdmin()));

      // 본인 문서만 수정 가능 (role·isBlacklisted 변경 차단)
      allow update: if isLoggedIn() &&
                       isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlacklisted']);

      // 슈퍼관리자: role·blacklist 등 민감 필드 수정 가능
      allow update: if isSuperAdmin();

      // 회원가입 시 문서 생성 (본인만)
      allow create: if isLoggedIn() && isOwner(userId);

      // 삭제는 슈퍼관리자만
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // businesses 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /businesses/{businessId} {

      allow read: if isLoggedIn();

      allow create: if isLoggedIn() &&
                       (isBusinessAdmin() || isSuperAdmin()) &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.adminIds;

      allow update: if isAdminOf(businessId) || isSuperAdmin();
      allow delete: if isAdminOf(businessId) || isSuperAdmin();

      match /workTypes/{workTypeId} {
        allow read: if isLoggedIn();
        allow write: if isAdminOf(businessId) || isSuperAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // tos 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /tos/{toId} {

      allow read: if isLoggedIn();

      allow create: if isLoggedIn() &&
                       (isAdminOf(request.resource.data.businessId) || isSuperAdmin());

      allow update: if isLoggedIn() &&
                       (isAdminOf(resource.data.businessId) || isSuperAdmin());

      allow delete: if isLoggedIn() &&
                       (isAdminOf(resource.data.businessId) || isSuperAdmin());

      match /workDetails/{workDetailId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() &&
                        (isAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSuperAdmin());
      }

      match /slots/{slotId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() &&
                        (isAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSuperAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════
    // applications 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /applications/{applicationId} {

      // 단일 문서 읽기 (get): 본인 · 사업장 오너 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   isOwner(resource.data.uid) ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // 목록 쿼리 (list):
      // - 일반 유저: uid 필터 쿼리로만 본인 지원서 조회 가능
      // - 관리자: businessId 필터 쿼리로 사업장 지원서 조회 가능
      // 쿼리에 uid/businessId 필터가 포함되면 Firestore가 per-doc 규칙을 정상 평가함
      allow list: if isLoggedIn() && (
                    isOwner(resource.data.uid) ||
                    isAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );

      // 생성: 반드시 본인 uid로만 생성
      allow create: if isLoggedIn() &&
                       request.resource.data.uid == request.auth.uid;

      allow update: if isLoggedIn() && (
                      (isOwner(resource.data.uid) &&
                       request.resource.data.status == 'CANCELED') ||
                      isAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 삭제: 슈퍼어드민 또는 해당 사업장 오너 (공고 삭제 시 연관 지원서 정리)
      allow delete: if isSuperAdmin() ||
                       isAdminOf(resource.data.businessId);
    }

    // ═══════════════════════════════════════════════════════════
    // attendance 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {

      allow read: if isLoggedIn() && (
                    isOwner(resource.data.userId) ||
                    isAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );

      // 생성: 반드시 본인 userId로만 생성 (출근 체크)
      allow create: if isLoggedIn() &&
                       request.resource.data.userId == request.auth.uid;

      allow update: if isLoggedIn() && (
                      isOwner(resource.data.userId) ||
                      isAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // notifications 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {

      // 읽기: 본인 알림만
      allow read: if isLoggedIn() && isOwner(resource.data.userId);

      // 생성: 로그인한 사용자 허용
      // 알림은 수신자(userId)를 대상으로 발신자가 생성하는 구조
      // (예: 관리자가 지원자에게, 지원자가 관리자에게)
      // ※ 모델에 senderUid 필드 추가 시 더 세밀한 제한 가능
      allow create: if isLoggedIn();

      // 수정·삭제: 본인만 (읽음 처리, 삭제)
      allow update: if isLoggedIn() && isOwner(resource.data.userId);
      allow delete: if isLoggedIn() && isOwner(resource.data.userId);
    }

    // ═══════════════════════════════════════════════════════════
    // reviews 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {

      allow read: if isLoggedIn();

      // 수정: 자기 사업장 근무자에게만 리뷰 작성 가능 (다른 사업장 침범 차단)
      allow create: if isLoggedIn() &&
                       isBusinessAdmin() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       isAdminOf(request.resource.data.businessId);

      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // groups 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /groups/{groupId} {

      allow read: if isLoggedIn();

      // 생성: 해당 사업장 관리자만 (request.resource로 businessId 검증)
      allow create: if isLoggedIn() && (
                      (isBusinessAdmin() && isAdminOf(request.resource.data.businessId)) ||
                      isSuperAdmin()
                    );

      // 수정·삭제: 해당 사업장 관리자만 (resource로 businessId 검증)
      allow update, delete: if isLoggedIn() && (
                              (isBusinessAdmin() && isAdminOf(resource.data.businessId)) ||
                              isSuperAdmin()
                            );
    }

    // ═══════════════════════════════════════════════════════════
    // schedule_change_requests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /schedule_change_requests/{requestId} {

      allow read: if isLoggedIn() && (
                    isOwner(resource.data.applicantUid) ||
                    isAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );

      // 생성: 지원자 본인 또는 해당 사업장 관리자(추가근무/미출근 요청)
      allow create: if isLoggedIn() && (
                       request.resource.data.applicantUid == request.auth.uid ||
                       isAdminOf(request.resource.data.businessId) ||
                       isSuperAdmin()
                     );

      allow update: if isLoggedIn() && (
                      isOwner(resource.data.applicantUid) ||
                      isAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // idCardAccessRequests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /idCardAccessRequests/{requestId} {

      allow read: if isLoggedIn() && (
                    isOwner(resource.data.requesterId) ||
                    isOwner(resource.data.targetUserId) ||
                    isSuperAdmin()
                  );

      allow create: if isLoggedIn() && isBusinessAdmin();

      allow update: if isLoggedIn() && (
                      isOwner(resource.data.targetUserId) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 컬렉션: 기본 차단
    // ═══════════════════════════════════════════════════════════
  }
}
