rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // 헬퍼 함수
    // ═══════════════════════════════════════════════════════════

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // [BUGFIX] 유저 문서가 없거나 role 필드가 없을 때 null safe 처리.
    // 기존 .data.role 직접 접근은 문서가 없으면 crash → 모든 권한 체크 실패.
    function myRole() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null ? u.data.get('role', null) : null;
    }

    function isSuperAdmin() {
      return isLoggedIn() && myRole() == 'SUPER_ADMIN';
    }

    function isBusinessAdmin() {
      return isLoggedIn() && myRole() == 'BUSINESS_ADMIN';
    }

    function isUser() {
      return isLoggedIn() && myRole() == 'USER';
    }

    // myRole()을 한 번만 호출해 중복 get() 방지
    function isAdmin() {
      let role = myRole();
      return isLoggedIn() && (role == 'SUPER_ADMIN' || role == 'BUSINESS_ADMIN');
    }

    // 특정 사업장의 adminIds에 포함된 관리자인지 확인
    // adminIds 필드가 없는 기존 문서는 ownerId로 폴백
    // [BUGFIX] null/빈 businessId 전달 시 get() 오류 방지 — whereIn 복합쿼리에서
    //          request.query.filters.businessId가 null 반환 시 isAdminOf(null) 오류로
    //          PERMISSION_DENIED가 발생하던 문제를 early-return으로 차단
    function isAdminOf(businessId) {
      let valid = businessId is string && businessId.size() > 0;
      let biz = valid ? get(/databases/$(database)/documents/businesses/$(businessId)) : null;
      return valid && isLoggedIn() &&
        biz != null &&
        biz.data != null && (
          biz.data.get('ownerId', '') == request.auth.uid ||
          ('adminIds' in biz.data && request.auth.uid in biz.data.adminIds)
        );
    }

    function isSubAdminOf(businessId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return businessId is string && businessId.size() > 0 &&
        isLoggedIn() &&
        u != null &&
        u.data != null &&
        u.data.get('subAdminOf', '') == businessId;
    }

    // 하위 관리자인지 (특정 businessId 무관, subAdminOf 필드 존재 여부만 확인)
    function isSubAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isLoggedIn() && u != null && u.data != null &&
        u.data.get('subAdminOf', '') != '';
    }

    function isNotBlacklisted() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u == null || u.data.get('isBlacklisted', false) == false;
    }

    // ═══════════════════════════════════════════════════════════
    // users 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {

      // get: 본인·슈퍼어드민은 전체, 사업장관리자·하위관리자는 근무자(USER)만 조회
      // (타 관리자의 FCM 토큰·은행계좌 등 민감정보 교차 접근 방지)
      allow get: if isLoggedIn() && (
                   isOwner(userId) ||
                   isSuperAdmin() ||
                   ((isBusinessAdmin() || isSubAdmin()) && resource.data.get('role', '') == 'USER')
                 );

      // 쿼리(LIST): 비로그인 limit=1 허용 (로그인·회원가입 username 조회용)
      // limit=30 제한으로 대량 덤프 방지 / getUsersBatch는 반드시 .limit(chunk.length) 필요
      allow list: if (!isLoggedIn() && request.query.limit <= 1) ||
                   (isLoggedIn() && isSuperAdmin()) ||
                   (isLoggedIn() && (isBusinessAdmin() || isSubAdmin()) && request.query.limit <= 30);

      // 슈퍼관리자: 민감 필드 포함 모든 필드 수정 가능 (최우선 — 운영 긴급 수정용)
      // [특이사항] Firestore Rules는 어느 allow 하나라도 true면 허용(OR)이므로 순서가 보안에는 영향 없음.
      // isSuperAdmin()을 최상단에 두어 다른 조건(isOwner 등)과 의도하지 않은 교차 해석을 방지.
      allow update: if isSuperAdmin();

      // 본인 문서 수정 (role·isBlacklisted·subAdminOf·신뢰도 관련 필드 변경 차단)
      // subAdminOf는 CF trigger 전용, trustScore/noShowCount/lateCount/totalWorkDays는 관리자 또는 CF 전용
      // restrictedUntil: 제재 만료 시각 — 본인이 삭제하여 제재 우회 방지
      allow update: if isLoggedIn() &&
                       isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'role', 'isBlacklisted', 'subAdminOf',
                         'trustScore', 'noShowCount', 'lateCount', 'totalWorkDays', 'lastRestartAt',
                         'restrictedUntil'
                       ]);

      // 관리자·하위관리자: 신뢰도·노쇼·근무일수 관련 필드만 업데이트 허용 (restrictedUntil 포함 — 노쇼 제재)
      // SUB_ADMIN도 출근 마감 처리 시 TrustScoreService를 통해 이 필드들을 업데이트한다
      allow update: if isLoggedIn() &&
                       (isAdmin() || isSubAdmin()) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['noShowCount', 'lateCount', 'trustScore',
                                   'totalWorkDays', 'lastRestartAt', 'updatedAt',
                                   'restrictedUntil']);

      // BUSINESS_ADMIN이 자기 사업장 멤버 제거 시 subAdminOf 삭제만 허용 (설정은 CF trigger 전용)
      // subAdminOf 지정(CF Admin SDK)·전체 수정(isSuperAdmin)은 위 최상단 규칙에서 처리
      allow update: if isLoggedIn() &&
                       isBusinessAdmin() &&
                       isAdminOf(resource.data.get('subAdminOf', '')) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subAdminOf']) &&
                       !('subAdminOf' in request.resource.data);

      // 회원가입(본인) 또는 관리자 더미 데이터 생성
      allow create: if isLoggedIn() && (
                      isOwner(userId) ||
                      (isAdmin() && request.resource.data.isDummy == true)
                    );

      allow delete: if isSuperAdmin() ||
                     (isAdmin() && resource.data.isDummy == true);

      // ─── users/{userId}/notifications 서브컬렉션 ─────────────
      // create: CF createNotification Callable(Admin SDK)로 단일화 — 클라이언트 직접 write 차단
      //   → 악의적 사용자가 타인에게 임의 알림을 발송하는 취약점 해소
      // read/update/delete: 본인 경로만 허용 (소유권 유지)
      match /notifications/{notificationId} {
        allow read: if isLoggedIn() && isOwner(userId);
        allow create: if false;
        allow update, delete: if isLoggedIn() && isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════
    // businesses 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /businesses/{businessId} {

      // 읽기: 해당 사업장 관리자·슈퍼어드민·지원자(신청한 TO의 사업장 정보 확인용)
      // 공개 정보(이름·주소·평점)는 로그인 사용자 전체 허용
      // 민감 정보(인감·관리자 목록)는 소유자만 허용
      allow get: if isLoggedIn();
      // list: request.query.filters는 arrayContains 쿼리에서 동작하지 않음
      // getMyBusiness()는 adminIds array-contains uid 쿼리를 사용하므로
      // isBusinessAdmin() 전체 허용 (get 규칙이 이미 isLoggedIn()으로 공개이므로 추가 노출 없음)
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    isBusinessAdmin()
                  );

      // 슈퍼어드민은 ownerId/adminIds 조건 없이 사업장 생성 가능 (타 관리자 대신 등록 포함)
      // 일반 관리자는 본인 ownerId이고 adminIds에 본인 uid가 있어야 함
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      (isBusinessAdmin() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.adminIds)
                    );

      // [특이사항] ownerId/adminIds 변경은 슈퍼어드민만 허용.
      // BUSINESS_ADMIN이 ownerId를 자신으로 변경하거나 다른 관리자를 adminIds에서 제거해
      // 사업장 소유권을 탈취하는 권한 모독 공격 방지.
      allow update: if (isAdminOf(businessId) || isSuperAdmin()) &&
                    (isSuperAdmin() ||
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['ownerId', 'adminIds']));
      allow delete: if isAdminOf(businessId) || isSuperAdmin();

      match /workTypes/{workTypeId} {
        allow read: if isLoggedIn();
        allow write: if isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin();
      }

      match /contract_templates/{templateId} {
        allow read: if isLoggedIn();
        allow write: if isAdminOf(businessId) || isSuperAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // tos 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /tos/{toId} {

      // get: 로그인한 모든 사용자 (공고 상세 조회)
      allow get: if isLoggedIn();
      // list: request.query.filters 미지원으로 역할 기반으로 허용
      // get이 isLoggedIn()으로 공개이므로 동일 수준의 노출
      allow list: if isLoggedIn();

      allow create: if isLoggedIn() &&
                       (isAdminOf(request.resource.data.businessId) || isSuperAdmin());

      // [특이사항] CLOSED·EXPIRED TO에서 핵심 운영 필드 변경 차단.
      // 마감 후 workDetailId·totalRequired 등을 변경하면 기존 applications 데이터와
      // 불일치가 발생하므로 슈퍼어드민만 예외 허용 (긴급 운영 수정 시).
      allow update: if isLoggedIn() &&
                       (isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId) ||
                        isSuperAdmin()) &&
                       (isSuperAdmin() ||
                        !(resource.data.get('status', '') in ['CLOSED', 'EXPIRED']) ||
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['workDetailId', 'totalRequired', 'startDate',
                                   'endDate', 'workDays', 'businessId', 'workTypeIds']));

      // 지원자: 지원/취소 시 totalPending 카운터만 수정 허용 (음수 방지)
      allow update: if isLoggedIn() && isUser() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['totalPending']) &&
                       request.resource.data.totalPending >= 0;

      // 지원자: 계약해지 수락 시 totalConfirmed·workTypeConfirmedCounts 감소 허용 (음수 방지)
      allow update: if isLoggedIn() && isUser() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['totalConfirmed', 'workTypeConfirmedCounts']) &&
                       request.resource.data.totalConfirmed >= 0;

      allow delete: if isLoggedIn() &&
                       (isAdminOf(resource.data.businessId) || isSuperAdmin());

      match /workDetails/{workDetailId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() &&
                        (isAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSubAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSuperAdmin());
      }

      match /slots/{slotId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() &&
                        (isAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSubAdminOf(
                          get(/databases/$(database)/documents/tos/$(toId)).data.businessId
                        ) || isSuperAdmin());
        // 지원자: 지원/취소 시 pendingCount·workTypeCounts 카운터만 수정 허용
        // [LOW-001] pendingCount 음수 방지 — tos.totalPending과 동일한 보호 적용
        allow update: if isLoggedIn() && isUser() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['pendingCount', 'workTypeCounts']) &&
                         request.resource.data.pendingCount >= 0;
        // 지원자: 계약해지 수락 시 confirmedCount·workTypeCounts 감소 허용 (음수 방지)
        allow update: if isLoggedIn() && isUser() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['confirmedCount', 'workTypeCounts']) &&
                         request.resource.data.confirmedCount >= 0;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // applications 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /applications/{applicationId} {

      // get: 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.uid) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: request.query.filters를 사용하지 않고 isLoggedIn()으로 허용.
      //
      // [설계 결정] request.query.filters는 Firestore 복합쿼리에서 신뢰할 수 없음:
      //   · whereIn/not-in/array-contains-any → filters에 해당 필드 노출 불가
      //   · where('uid').orderBy('appliedAt', desc) 등 복합 인덱스 쿼리 → filters.uid = null
      //   · where('toId').where('uid') 등 다중 equality 복합 쿼리 → 일부 필드 누락
      //   위 경우 filters 기반 규칙이 정당한 쿼리를 PERMISSION_DENIED로 차단.
      //
      // [보안 보완]
      //   · 앱 코드는 항상 uid 또는 businessId 필터를 쿼리에 포함 (코드 수준 보장)
      //   · get 규칙이 개별 문서 접근을 제어 (본인·관리자·슈퍼어드민만 허용)
      //   · 악의적 사용자가 필터 없이 조회하더라도 각 컬렉션의 get 규칙이 문서 단위로 차단
      allow list: if isLoggedIn();

      // 생성: 본인 uid, 관리자 더미 데이터, 또는 해당 사업장 관리자(계약 연장 등)
      allow create: if isLoggedIn() && (
                      request.resource.data.uid == request.auth.uid ||
                      (isAdmin() && request.resource.data.isDummy == true) ||
                      isAdminOf(request.resource.data.businessId)
                    );

      allow update: if isLoggedIn() && (
                      // 지원 취소 (본인 PENDING → CANCELED): status/canceledAt/statusHistory만 허용
                      // [036] CONTRACT_PENDING 상태에서 취소 불가 — 관리자 개입 필요
                      (isOwner(resource.data.uid) &&
                       resource.data.status == 'PENDING' &&
                       request.resource.data.status == 'CANCELED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'canceledAt', 'cancelReason', 'statusHistory'])) ||
                      // 자동 만료 (본인: PENDING → AUTO_CANCELED)
                      (isOwner(resource.data.uid) &&
                       resource.data.status == 'PENDING' &&
                       request.resource.data.status == 'AUTO_CANCELED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'canceledAt', 'cancelReason'])) ||
                      // 재지원 (본인: CANCELED/AUTO_CANCELED → PENDING, uid/businessId/toId 불변)
                      // [035] AUTO_CANCELED 상태에서도 재지원 허용
                      (isOwner(resource.data.uid) &&
                       (resource.data.status == 'CANCELED' ||
                        resource.data.status == 'AUTO_CANCELED') &&
                       request.resource.data.status == 'PENDING' &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'businessId', 'toId'])) ||
                      // 근로계약서 서명 완료 (본인: CONTRACT_PENDING → CONFIRMED)
                      (isOwner(resource.data.uid) &&
                       resource.data.status == 'CONTRACT_PENDING' &&
                       request.resource.data.status == 'CONFIRMED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'statusHistory'])) ||
                      // 퇴사 요청 제출 (본인: CONFIRMED 상태, resignStatus→PENDING)
                      (isOwner(resource.data.uid) &&
                       resource.data.status == 'CONFIRMED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['resignStatus', 'resignRequestedAt', 'resignRequestDate']) &&
                       request.resource.data.get('resignStatus', '') == 'PENDING') ||
                      // 퇴사 요청 취소 (본인: PENDING 상태 요청 철회 → null)
                      (isOwner(resource.data.uid) &&
                       resource.data.get('resignStatus', '') == 'PENDING' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['resignStatus', 'resignRequestedAt', 'resignRequestDate']) &&
                       request.resource.data.resignStatus == null) ||
                      // 계약해지 수락 (본인: terminationStatus PENDING → APPROVED, status → CANCELED)
                      // 관리자가 요청한 해지를 근무자가 수락하는 흐름 — 관리자 수준 필드 변경 허용
                      (isOwner(resource.data.uid) &&
                       resource.data.get('terminationStatus', '') == 'PENDING' &&
                       request.resource.data.get('terminationStatus', '') == 'APPROVED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['terminationStatus', 'terminationRespondedAt',
                                   'actualResignDate', 'status'])) ||
                      // 관리자: uid·businessId·toId·workDetailId 불변
                      // slotId는 의도적으로 허용 — 파트 변경 기능 (근무자를 다른 슬롯으로 이동)
                      // workDetailId는 차단 — TO 내 다른 workDetail로 이동은 실질적 재계약에 해당
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'businessId', 'toId', 'workDetailId'])) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin() ||
                       isAdminOf(resource.data.businessId);
    }

    // ═══════════════════════════════════════════════════════════
    // attendance 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {

      // get: 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.userId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [크로스-사업장 방지]
      //   · USER: 앱 코드에서 항상 userId == auth.uid 필터 포함 (코드 수준 보장)
      //     단, userId 등호 + workDate 범위 + orderBy 복합 쿼리에서
      //     request.query.filters.userId가 null을 반환해 PERMISSION_DENIED가 발생하므로
      //     isUser() 역할 체크만으로 허용 (applications 컬렉션과 동일한 설계 결정)
      //   · BUSINESS_ADMIN: 쿼리 필터 businessId 우선, 없으면 user.businessId 폴백
      //     whereIn 복합쿼리에서 request.query.filters.businessId가 null 반환될 수 있으므로
      //     코드 레벨에서도 whereIn 제거 후 클라이언트 필터링 병행
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    isUser() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    ))
                  );

      // 생성: 본인 또는 해당 사업장 관리자(수동 출근 처리) 또는 더미 데이터
      // 슈퍼어드민은 isAdminOf() 없이도 모든 사업장 출근 기록 수동 생성 가능
      allow create: if isLoggedIn() && (
                      request.resource.data.userId == request.auth.uid ||
                      isAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin() ||
                      (isAdmin() && request.resource.data.isDummy == true)
                    );

      // wageStatus 역전환 방지: transferred 상태는 관리자/슈퍼어드민도 되돌릴 수 없음
      // 근무자: 퇴근 체크 전용 필드만 수정 허용 (checkIn/wageDetail 등 변조 불가)
      // wageStatus가 confirmed/calculated 이상이면 근무자의 퇴근 수정도 차단
      // [143] transferredBy 필드 변경 시 본인 UID만 허용 — 감사 추적 위변조 방지
      allow update: if isLoggedIn() &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['transferredBy']) ||
                       request.resource.data.transferredBy == request.auth.uid) &&
                      !(resource.data.wageStatus == 'transferred' &&
                        request.resource.data.wageStatus != 'transferred') && (
                      // 근무자: wageStatus가 pending/unchecked 상태일 때만 퇴근 관련 필드 수정 허용
                      (resource.data.wageStatus != 'transferred' &&
                       resource.data.wageStatus != 'confirmed' &&
                       resource.data.wageStatus != 'calculated' &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'checkOut', 'checkOutLat', 'checkOutLng', 'checkOutMethod',
                         'workHours', 'status', 'updatedAt', 'originalCheckOut'
                       ])) ||
                      isAdminOf(resource.data.businessId) ||
                      isSubAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 관리자: 소속 사업장 출근 기록 삭제 허용 (TO 삭제 시 고아 데이터 정리)
      // wageTransferred/wageConfirmed 기록은 코드 레벨에서 보존 처리
      allow delete: if isSuperAdmin() ||
                     isAdminOf(resource.data.businessId) ||
                     (isAdmin() && resource.data.isDummy == true);
    }

    // ═══════════════════════════════════════════════════════════
    // monthly_reviews 컬렉션 (실 사용 컬렉션)
    // ═══════════════════════════════════════════════════════════
    match /monthly_reviews/{reviewId} {

      // get: 본인(작성자/수신자), 해당 사업장 관리자, 공개 리뷰
      // resource == null: 문서 미존재 시 존재 여부 확인 허용 (리뷰 작성 여부 체크)
      allow get: if isLoggedIn() && (
        isSuperAdmin() ||
        resource == null ||
        resource.data.reviewerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdminOf(resource.data.businessId) ||
        resource.data.isPublished == true
      );
      // list: [MEDIUM-003] USER는 본인 필터 필수, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] isAdminOf(businessId)로 타 사업장 리뷰 덤프 차단
      // · USER 허용 필터: reviewerId==uid, targetUserId==uid, isPublished==true
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && (
          isAdminOf(request.query.filters.businessId) ||
          isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
        )) ||
        (isSubAdmin() && (
          isSubAdminOf(request.query.filters.businessId) ||
          isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
        )) ||
        (isUser() && (
          request.query.filters.reviewerId == request.auth.uid ||
          request.query.filters.targetUserId == request.auth.uid ||
          request.query.filters.isPublished == true
        ))
      );

      // ADMIN_TO_USER: 해당 사업장 관리자만 작성
      // USER_TO_BUSINESS: 블랙리스트 미포함 일반 유저, 본인 명의(reviewerId == auth.uid)만 허용
      // requestId 필수 — review_requests와 연결되지 않은 가짜 리뷰 차단.
      // 소유자 검증(workerId == reviewerId)은 onReviewCreated CF 트리거에서 수행.
      // [특이사항] Firestore 규칙에서 review_requests.get()으로 workerId 검증 시
      // 규칙 평가 비용 급증 및 get() 호출 실패 시 PERMISSION_DENIED 오류 발생 위험이 있어
      // CF 레벨 검증으로 위임. 가짜 리뷰는 생성 직후 CF가 삭제하므로 노출 시간 최소화.
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      (request.resource.data.reviewType == 'ADMIN_TO_USER' &&
                       isAdminOf(request.resource.data.businessId)) ||
                      (request.resource.data.reviewType == 'USER_TO_BUSINESS' &&
                       isUser() && isNotBlacklisted() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       'businessId' in request.resource.data &&
                       request.resource.data.businessId.size() > 0 &&
                       'requestId' in request.resource.data)
                    );

      // 사업장 답변 추가(USER_TO_BUSINESS): 사업장 관리자는 답변 필드만 수정 가능
      // (평점·태그·코멘트 등 근무자가 작성한 필드는 수정 불가 — 리뷰 조작 방지)
      allow update: if isSuperAdmin() ||
                     (isLoggedIn() && isAdminOf(resource.data.businessId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['businessResponse', 'businessRespondedAt']));

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // badges 컬렉션 (배지 설정 — 슈퍼어드민 전용)
    // ═══════════════════════════════════════════════════════════
    match /badges/{badgeId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // work_types 컬렉션 (업무 유형 — 읽기 전체, 쓰기 관리자)
    // ═══════════════════════════════════════════════════════════
    match /work_types/{workTypeId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // reviews 컬렉션 (레거시 — 신규 사용 없음)
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {

      // get: 작성자·대상자·사업장 관리자
      allow get: if isLoggedIn() && (
        isSuperAdmin() ||
        resource.data.reviewerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdminOf(resource.data.businessId)
      );
      // list: [LOW-003] 레거시 컬렉션 — 관리자 이상으로 제한 (USER 전체 열람 차단)
      allow list: if isAdmin() || isSuperAdmin();

      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      (isAdminOf(request.resource.data.businessId) &&
                       request.resource.data.reviewerId == request.auth.uid)
                    );

      allow update: if isSuperAdmin() ||
                     (isLoggedIn() &&
                      isAdminOf(resource.data.businessId) &&
                      resource.data.reviewerId == request.auth.uid);

      allow delete: if isSuperAdmin() ||
                     (isAdmin() && resource.data.isDummy == true);
    }

    // ═══════════════════════════════════════════════════════════
    // groups 컬렉션 (Deprecated — 신규 코드에서 미사용)
    // ═══════════════════════════════════════════════════════════
    match /groups/{groupId} {

      // [LOW-002] 레거시 컬렉션이나 관리자 이상으로 read 제한 (USER 전체 열람 차단)
      allow read: if isAdmin() || isSuperAdmin();

      allow create: if isLoggedIn() && (
                      (isBusinessAdmin() && isAdminOf(request.resource.data.businessId)) ||
                      isSuperAdmin()
                    );

      allow update, delete: if isLoggedIn() && (
                              (isBusinessAdmin() && isAdminOf(resource.data.businessId)) ||
                              isSuperAdmin()
                            );
    }

    // ═══════════════════════════════════════════════════════════
    // schedule_change_requests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /schedule_change_requests/{requestId} {

      // get: 지원자 본인 · 해당 사업장 관리자 · 슈퍼어드민 (resource==null: 문서 미존재 시 허용)
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.applicantUid) ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [HIGH-001] USER는 본인 applicantUid 필터 필수, 관리자는 소속 사업장 필터
      // [크로스-사업장 방지] isAdminOf(businessId)로 타 사업장 스케줄 변경 요청 덤프 차단
      // [BUGFIX] TO 삭제 시 applicationId whereIn 쿼리 지원 — businessId 필터 없이도
      //   관리자 본인의 user 문서 businessId로 검증하는 폴백 추가
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    )) ||
                    isUser()  // 복합 쿼리에서 filters.applicantUid null 반환 대비, 앱 코드에서 applicantUid==auth.uid 보장
                  );

      // 생성: 지원자 본인 또는 해당 사업장 관리자(추가근무/미출근 요청)
      allow create: if isLoggedIn() && (
                      request.resource.data.applicantUid == request.auth.uid ||
                      isAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 수정: 워커는 본인 요청 취소(CANCELED)만, 관리자는 승인/거절 처리
      allow update: if isLoggedIn() && (
                      // 워커: status=CANCELED로만 변경, respondedByUid·respondedAt은 관리자 전용
                      (isOwner(resource.data.applicantUid) &&
                       request.resource.data.status == 'CANCELED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status'])) ||
                      isAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 관리자: 소속 사업장 스케줄 변경 요청 삭제 허용 (TO 삭제 시 고아 데이터 정리)
      allow delete: if isSuperAdmin() || isAdminOf(resource.data.businessId);
    }

    // ═══════════════════════════════════════════════════════════
    // idCardAccessRequests 컬렉션
    // ═══════════════════════════════════════════════════════════
    // idCardAccessRequests 컬렉션 (신분증 열람 요청)
    //
    // 데이터 구조:
    //   requesterId          — 요청한 관리자 uid
    //   requesterBusinessId  — 요청한 관리자의 사업장 id
    //   targetUserId         — 신분증 제공 대상 근무자 uid
    //   applicationId        — 연관 지원서 id
    //   status               — pending | approved | rejected | canceled | expired
    //   expiresAt            — 승인 후 만료 시각 (서버에서 기록)
    //
    // 설계 원칙:
    //   · BUSINESS_ADMIN/SubAdmin은 반드시 소속 필터(requesterId 또는 requesterBusinessId) 필수
    //     → 타 사업장 신분증 열람 요청 목록 덤프 방지
    //   · create 시 requesterBusinessId가 본인 소속 사업장인지 isAdminOf로 검증
    //     → 타 사업장 명의로 요청 생성 차단
    //   · update는 targetUserId(근무자 본인)만 상태 변경 가능 (승인/거절)
    //     → 관리자가 수신자 대신 승인/거절하는 것 차단
    // ═══════════════════════════════════════════════════════════
    match /idCardAccessRequests/{requestId} {

      // get: 요청자(requesterId)·수신자(targetUserId)·슈퍼어드민만 단건 조회 가능
      // resource==null: 문서 미존재 시 createIdCardAccessRequest 중복 체크 허용
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.requesterId) ||
                   isOwner(resource.data.targetUserId) ||
                   isSuperAdmin()
                 );

      // list: [크로스-사업장 방지] 관리자도 반드시 소속 필터 필수
      //
      // 허용 패턴 (앱 코드 쿼리와 1:1 매핑):
      //   A) requesterId == auth.uid
      //      → getMyIdCardRequests (내가 보낸 요청 목록)
      //      → createIdCardAccessRequest 중복 체크 (requesterId + targetUserId + status)
      //      → checkIdCardAccess 최신 조회 (requesterId + targetUserId)
      //
      //   B) isAdminOf(requesterBusinessId) / isSubAdminOf(requesterBusinessId)
      //      → _cleanupApplicationRelatedData 관리자 취소 경로
      //        (applicationId + requesterBusinessId + status 쿼리)
      //      → 같은 사업장 내 다른 관리자가 보낸 요청도 포함 (의도된 동작:
      //         관리자 변경 시에도 소속 사업장의 모든 요청 정리 가능)
      //
      //   C) targetUserId == auth.uid
      //      → getPendingIdCardRequestsForUser (내게 온 요청 목록)
      //      → _cleanupApplicationRelatedData 사용자 취소 경로
      //        (applicationId + targetUserId + status 쿼리)
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    ((isBusinessAdmin() || isSubAdmin()) &&
                     request.query.filters.requesterId == request.auth.uid) ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.requesterBusinessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.requesterBusinessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    )) ||
                    isUser()  // 복합 쿼리에서 filters.targetUserId null 반환 대비, 앱 코드에서 targetUserId==auth.uid 보장
                  );

      // create: BUSINESS_ADMIN / SubAdmin / 슈퍼어드민이 발신 가능 (H-7)
      //   · requesterId == auth.uid : 본인 명의로만 생성 (타인 명의 위조 차단)
      //   · isAdminOf/isSubAdminOf(requesterBusinessId) : 소속 사업장 명의로만 생성
      //     → 타 사업장 명의로 요청 생성해 불법 신분증 열람 시도 차단
      //   · isSuperAdmin() : 감사/운영 목적 신분증 열람 요청 허용
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      ((isBusinessAdmin() || isSubAdmin()) &&
                       request.resource.data.requesterId == request.auth.uid &&
                       (isAdminOf(request.resource.data.requesterBusinessId) ||
                        isSubAdminOf(request.resource.data.requesterBusinessId)))
                    );

      // update: 수신자(targetUserId = 근무자 본인)만 상태 변경 가능
      //   · 변경 가능 필드: status, respondedAt, rejectionReason, expiresAt
      //   · status = approved 시 expiresAt은 앱 코드에서 +7일로 기록
      //   · 관리자가 직접 승인/거절 불가 — 근무자 동의 기반 설계
      allow update: if isLoggedIn() && (
                      (isOwner(resource.data.targetUserId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'respondedAt', 'rejectionReason', 'expiresAt'])) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // review_requests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /review_requests/{requestId} {

      // get: 해당 워커 본인 · 해당 사업장 관리자 · 슈퍼어드민 (resource==null: 문서 미존재 시 허용)
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.workerId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [MEDIUM-004] USER는 본인 workerId 필터 필수, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] isAdminOf(businessId)로 타 사업장 리뷰 요청 덤프 차단
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    )) ||
                    isUser()  // 복합 쿼리에서 filters.workerId null 반환 대비, 앱 코드에서 workerId==auth.uid 보장
                  );

      // 생성: 해당 사업장 관리자 또는 슈퍼어드민
      allow create: if isLoggedIn() && (
                      isAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 수정: 워커(자신의 리뷰 제출 필드만) · 해당 사업장 관리자(자신의 필드만) · 슈퍼어드민
      allow update: if isLoggedIn() && (
                      // 워커: 자신의 리뷰 제출 필드만 (isPublished 등 변조 불가)
                      (isOwner(resource.data.workerId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['workerStatus', 'workerReviewId'])) ||
                      // 관리자: 자신의 리뷰 제출 필드만
                      (isAdminOf(resource.data.businessId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['adminStatus', 'adminReviewId'])) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // settings 컬렉션 (앱 공통 설정 — review_tags, trust_rules 등)
    // ═══════════════════════════════════════════════════════════
    match /settings/{settingId} {

      // 읽기: 로그인된 사용자 전체 (최저임금·보험요율 등 공개 설정)
      allow read: if isLoggedIn();

      // 쓰기: 슈퍼어드민만 (일반 관리자 설정 조작 차단)
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // worker_locations 컬렉션 (근로자 실시간 위치)
    // ═══════════════════════════════════════════════════════════
    match /worker_locations/{applicationId} {

      // get: 본인 · 해당 사업장 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.userId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [크로스-사업장 방지] 관리자는 소속 사업장 businessId 필터 필수
      //   · 위치정보는 개인정보보호법 상 민감 정보 — 엄격한 사업장 소속 검증 필수
      //   · USER(근무자) 본인 조회: get으로만 처리 (list 불필요, applicationId 문서 ID로 직접 접근)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getActiveLocationsForBusiness: .where('businessId', isEqualTo: businessId)
      //     - getLocationsForApplications: .where('businessId', isEqualTo: businessId)
      //       + .where(FieldPath.documentId, whereIn: chunk) — 복합 쿼리 (복합 인덱스 필요)
      //   · SubAdmin: 동일 패턴
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    ))
                  );

      // 생성·수정: 본인(userId == auth.uid) 또는 슈퍼어드민
      allow create: if isLoggedIn() && (
                      request.resource.data.userId == request.auth.uid ||
                      isSuperAdmin()
                    );

      allow update: if isLoggedIn() && (
                      isOwner(resource.data.userId) ||
                      isSuperAdmin()
                    );

      // 삭제: 슈퍼어드민 또는 본인
      allow delete: if isSuperAdmin() ||
                     (isLoggedIn() && isOwner(resource.data.userId));
    }

    // ═══════════════════════════════════════════════════════════
    // trust_score_history 컬렉션 (신뢰도 변동 이력)
    // ═══════════════════════════════════════════════════════════
    match /trust_score_history/{historyId} {
      // get: 단건 조회 — resource가 존재할 때만 userId 접근 가능
      allow get: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (resource != null && isOwner(resource.data.userId))
                 );
      // list: USER는 본인 userId 필터 필수, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] 타 사업장 근무자 신뢰도 이력 덤프 차단
      //   · USER: userId == auth.uid 필터 (본인 신뢰도 변동 이력 조회)
      //     - getScoreHistory(userId) — businessId 없이 호출 (USER 컨텍스트)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getScoreHistory(userId, businessId: businessId) — 관리자 컨텍스트
      //   · SubAdmin: isSubAdminOf(businessId) 필터 (동일 패턴)
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (isBusinessAdmin() && (
                     isAdminOf(request.query.filters.businessId) ||
                     isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                   )) ||
                   (isSubAdmin() && (
                     isSubAdminOf(request.query.filters.businessId) ||
                     isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                   )) ||
                   isUser()  // 복합 쿼리에서 filters.userId null 반환 대비, 앱 코드에서 userId==auth.uid 보장
                 );
      // 생성: 해당 사업장 관리자·하위관리자 또는 슈퍼어드민
      // SUB_ADMIN도 출근 마감 처리 시 TrustScoreService를 통해 생성한다
      allow create: if isLoggedIn() && (
                     isAdminOf(request.resource.data.businessId) ||
                     isSubAdminOf(request.resource.data.businessId) ||
                     isSuperAdmin()
                   );
      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // restart_program_history 컬렉션 (재시작 프로그램 신청 이력)
    // ═══════════════════════════════════════════════════════════
    match /restart_program_history/{historyId} {
      allow get: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (resource != null && isOwner(resource.data.userId))
                 );
      // list: [MEDIUM] CF 전용 컬렉션 — 슈퍼어드민 + 본인만 허용 (클라이언트 쓰기 없음)
      allow list: if isLoggedIn() && (
                   isSuperAdmin() ||
                   isUser()  // 복합 쿼리에서 filters.userId null 반환 대비, 앱 코드에서 userId==auth.uid 보장
                 );
      // 생성: Cloud Function(applyRestartProgram) Admin SDK만 허용 (클라이언트 직접 쓰기 차단)
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // employment_contracts 컬렉션 (근로계약서)
    // ═══════════════════════════════════════════════════════════
    match /employment_contracts/{contractId} {

      // get: 근무자 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.workerId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [CRITICAL-001] USER는 본인(workerId) 계약서만, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] isAdminOf(businessId)로 타 사업장 계약서 덤프 차단
      //   · USER: workerId == auth.uid 필터 필수 (모든 사업장의 본인 계약서 조회 = 정상 설계)
      //     - getByApplication(applicationId, workerId: uid) — 개인정보(서명 URL 등) 포함
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getByApplication(applicationId, businessId: businessId)
      //     - _findBundle(businessId: businessId) — 번들 계약서 탐색 시 사업장 검증
      //   · USER가 businessId 필터를 쓰면 → workerId 필터 없이 타인 계약서 열람 가능 → 차단
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                   isSuperAdmin() ||
                   isUser() ||  // 복합 쿼리에서 filters.workerId null 반환 대비, 앱 코드에서 workerId==auth.uid 보장
                   (isBusinessAdmin() && (
                     isAdminOf(request.query.filters.businessId) ||
                     isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                   )) ||
                   (isSubAdmin() && (
                     isSubAdminOf(request.query.filters.businessId) ||
                     isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                   ))
                 );

      // 생성: 해당 사업장 관리자 또는 슈퍼어드민 (확정 시 자동 생성)
      allow create: if isLoggedIn() && (
                      isAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 슈퍼어드민: 계약 상태에 관계없이 수정 가능 (오기재 정정 등 운영 목적)
      allow update: if isSuperAdmin();

      // 근무자: 계약해지 수락 시 계약서 voided 전환 허용
      // pending_employer/pending_worker 상태의 계약서를 voided로 전환 (completed/voided는 불변)
      allow update: if isLoggedIn() &&
                      isOwner(resource.data.workerId) &&
                      resource.data.status != 'completed' &&
                      resource.data.status != 'voided' &&
                      request.resource.data.get('status', '') == 'voided' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'contractVoidedAt', 'voidReason']);

      // 수정: 역할별 수정 가능 필드 제한 (completed·voided 상태는 관리자/근무자 차단)
      allow update: if isLoggedIn() &&
                      resource.data.status != 'completed' &&
                      resource.data.status != 'voided' && (
                        // 근무자: 자신의 서명 관련 필드만 (계약 내용 변경 불가)
                        (isOwner(resource.data.workerId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'workerSignatureUrl', 'workerSignatureHash',
                           'workerSignedAt', 'pdfUrl', 'updatedAt'
                         ])) ||
                        // 관리자: 사업주 서명 + 계약 관리 필드만
                        // [H-003] articles/templateId는 근무자 서명 전에만 수정 가능
                        (isAdminOf(resource.data.businessId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'employerSignatureUrl', 'employerSignatureHash',
                           'employerSignedAt', 'updatedAt',
                           'articles', 'templateId', 'slots', 'applicationIds'
                         ]) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['articles', 'templateId']) ||
                          resource.data.get('workerSignedAt', null) == null))
                      );

      // [특이사항] voidContract() 실행 흐름: 계약서를 voided 전환 후 application 취소 루프 실행.
      // 일부 application 취소 실패 시 failedIds를 voidFailedAppIds에 기록해 재처리(retryVoidFailedApps)에 사용.
      // 이 시점엔 이미 status='voided'이므로 위 update 규칙(status != voided 조건)에서 막힘 → 별도 규칙 필요.
      allow update: if isLoggedIn() &&
                      isAdminOf(resource.data.businessId) &&
                      resource.data.status == 'voided' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['voidFailedAppIds']);

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // member_invitations 컬렉션 (하위 관리자 초대)
    // ═══════════════════════════════════════════════════════════
    match /member_invitations/{invitationId} {

      // get: 수신자 · 발신자 · 해당 사업장 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   request.auth.uid == resource.data.targetUid ||
                   request.auth.uid == resource.data.invitedBy ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: USER는 본인 targetUid 필터 필수, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] 타 사업장 초대 목록 덤프 차단
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (isBusinessAdmin() && (
                     isAdminOf(request.query.filters.businessId) ||
                     isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                   )) ||
                   (isSubAdmin() && (
                     isSubAdminOf(request.query.filters.businessId) ||
                     isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                   )) ||
                   isUser()  // 복합 쿼리에서 filters.targetUid null 반환 대비, 앱 코드에서 targetUid==auth.uid 보장
                 );

      // 생성: 해당 사업장 관리자만 (초대 발송)
      allow create: if isLoggedIn() && (
                      isAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()
                    );

      // 수정: 초대받은 사람(수락/거절) · 해당 사업장 관리자(취소) · 슈퍼어드민
      // [SEC-001] 수신자는 status/respondedAt 필드만 변경 가능 (businessId 조작 차단)
      allow update: if isLoggedIn() && (
                      (request.auth.uid == resource.data.targetUid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'respondedAt'])) ||
                      isAdminOf(resource.data.businessId) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/{businessId}/members 서브컬렉션 (하위 관리자 목록)
    // ═══════════════════════════════════════════════════════════
    match /businesses/{businessId}/members/{uid} {

      // 단일 문서 읽기: 해당 사업장 관리자 · 멤버 본인 · 하위 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                    isAdminOf(businessId) ||
                    request.auth.uid == uid ||
                    isSubAdminOf(businessId) ||
                    isSuperAdmin()
                  );

      // 목록 조회(getMembers): 해당 사업장 관리자 · 하위 관리자 · 슈퍼어드민
      // list 시 uid 와일드카드가 unbound이므로 request.auth.uid == uid 사용 불가
      allow list: if isLoggedIn() && (
                    isAdminOf(businessId) ||
                    isSubAdminOf(businessId) ||
                    isSuperAdmin()
                  );

      // 생성: 해당 사업장 관리자 · 초대 수락 시 본인(uid 일치) · 슈퍼어드민
      allow create: if isLoggedIn() && (
                      isAdminOf(businessId) ||
                      request.auth.uid == uid ||
                      isSuperAdmin()
                    );

      // 수정: 해당 사업장 관리자만 (권한 변경)
      allow update: if isLoggedIn() && (
                      isAdminOf(businessId) ||
                      isSuperAdmin()
                    );

      // 삭제: 해당 사업장 관리자 · 본인(자진 탈퇴) · 슈퍼어드민
      allow delete: if isLoggedIn() && (
                      isAdminOf(businessId) ||
                      request.auth.uid == uid ||
                      isSuperAdmin()
                    );
    }

    // ═══════════════════════════════════════════════════════════
    // payroll_summaries 컬렉션 (급여 월별 집계)
    // ═══════════════════════════════════════════════════════════
    match /payroll_summaries/{summaryId} {

      // 읽기: 해당 사업장 관리자·하위 관리자·슈퍼어드민
      allow read: if isLoggedIn() && (
                   resource == null ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // 쓰기: Cloud Functions Admin SDK만 허용 (클라이언트 직접 쓰기 차단)
      // Admin SDK는 Firestore 규칙 우회 → 클라이언트는 항상 거부
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // deleted_accounts 컬렉션 (탈퇴 계정 기록 — 재가입 제한용)
    // ═══════════════════════════════════════════════════════════
    match /deleted_accounts/{docId} {
      // 읽기: 슈퍼어드민만 (원본 복구·블랙리스트 관리용)
      allow read: if isSuperAdmin();

      // 쓰기(추가): 본인 uid와 일치하는 경우만 생성 (타인 탈퇴 위조 방지)
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;

      // 수정·삭제: 슈퍼어드민만
      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // passwordResetCodes 컬렉션 (비밀번호 재설정 인증코드)
    // ═══════════════════════════════════════════════════════════
    match /passwordResetCodes/{username} {
      // Cloud Functions(Admin SDK)만 읽기·쓰기 (클라이언트 접근 차단)
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // payment_change_requests 컬렉션 (지급방식 변경 요청)
    // ═══════════════════════════════════════════════════════════
    match /payment_change_requests/{reqId} {
      // get: 요청자 본인 · 해당 사업장 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                    resource == null ||
                    isOwner(resource.data.workerId) ||
                    isAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );
      // list: [크로스-사업장 방지] 관리자는 소속 사업장 businessId 필터 필수
      //   · USER는 get으로 개별 접근 (list는 타인 급여 데이터 노출 위험)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getPaymentChangeRequestsByBusiness: .where('businessId', isEqualTo: businessId)
      //   · SubAdmin: 동일 패턴
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    ))
                  );
      // 생성: 본인 workerId이거나 해당 사업장 관리자 (타인 명의 위조 방지)
      allow create: if isLoggedIn() && (
                    request.resource.data.workerId == request.auth.uid ||
                    isAdminOf(request.resource.data.businessId) ||
                    isSuperAdmin()
                  );
      // 수정: 해당 사업장 관리자 · 슈퍼어드민 (승인/거절)
      allow update: if isLoggedIn() && (
                    isAdminOf(resource.data.businessId) || isSuperAdmin()
                  );
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // interim_settlement_requests 컬렉션 (중간정산 요청)
    // ═══════════════════════════════════════════════════════════
    match /interim_settlement_requests/{reqId} {
      // get: 요청자 본인 · 해당 사업장 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                    resource == null ||
                    isOwner(resource.data.workerId) ||
                    isAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );
      // list: [크로스-사업장 방지] 관리자는 소속 사업장 businessId 필터 필수
      //   · USER는 get으로 개별 접근 (list는 타인 급여 데이터 노출 위험)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getInterimSettlementsByBusiness: .where('businessId', isEqualTo: businessId)
      //   · SubAdmin: 동일 패턴
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      allow list: if isLoggedIn() && (
                    isSuperAdmin() ||
                    (isBusinessAdmin() && (
                      isAdminOf(request.query.filters.businessId) ||
                      isAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', ''))
                    )) ||
                    (isSubAdmin() && (
                      isSubAdminOf(request.query.filters.businessId) ||
                      isSubAdminOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subAdminOf', ''))
                    ))
                  );
      // 생성: 본인 workerId이거나 해당 사업장 관리자
      allow create: if isLoggedIn() && (
                    request.resource.data.workerId == request.auth.uid ||
                    isAdminOf(request.resource.data.businessId) ||
                    isSuperAdmin()
                  );
      allow update: if isLoggedIn() && (
                    isAdminOf(resource.data.businessId) || isSuperAdmin()
                  );
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // SMS 인증 코드 — Cloud Functions Admin SDK만 접근 (클라이언트 차단)
    // 전화번호가 문서 ID이므로 외부 노출 방지
    // ═══════════════════════════════════════════════════════════
    match /sms_verifications/{phone} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 이메일 인증 코드 — Cloud Functions Admin SDK만 접근
    // ═══════════════════════════════════════════════════════════
    match /emailVerificationCodes/{email} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 앱 설정 (약관 등) — 읽기: 로그인 사용자, 쓰기: 슈퍼관리자만
    // ═══════════════════════════════════════════════════════════
    match /app_settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // id_card_copy_logs — 주민번호 복사 감사 로그 (개인정보보호법 접근 기록)
    //   · create: 로그인한 관리자/서브어드민만, viewerId == auth.uid 검증
    //   · read: 슈퍼어드민만 (감사 목적)
    //   · update/delete: 전면 차단 (감사 로그 불변 보장)
    // ═══════════════════════════════════════════════════════════
    match /id_card_copy_logs/{logId} {
      allow create: if isLoggedIn() &&
                      (isBusinessAdmin() || isSubAdmin()) &&
                      request.resource.data.viewerId == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 컬렉션: 기본 차단
    // ═══════════════════════════════════════════════════════════
  }
}
