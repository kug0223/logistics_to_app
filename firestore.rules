rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // 헬퍼 함수
    // ═══════════════════════════════════════════════════════════

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // [BUGFIX] 유저 문서가 없거나 role 필드가 없을 때 null safe 처리.
    // 기존 .data.role 직접 접근은 문서가 없으면 crash → 모든 권한 체크 실패.
    function myRole() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null ? u.data.get('role', null) : null;
    }

    function isSuperAdmin() {
      return isLoggedIn() && myRole() == 'SUPER_ADMIN';
    }

    function isBusinessAdmin() {
      return isLoggedIn() && myRole() == 'BUSINESS_ADMIN';
    }

    function isUser() {
      return isLoggedIn() && myRole() == 'USER';
    }

    // myRole()을 한 번만 호출해 중복 get() 방지
    function isAdmin() {
      let role = myRole();
      return isLoggedIn() && (role == 'SUPER_ADMIN' || role == 'BUSINESS_ADMIN');
    }

    // 특정 사업장의 adminIds에 포함된 관리자인지 확인
    // adminIds 필드가 없는 기존 문서는 ownerId로 폴백
    // [BUGFIX] null/빈 businessId 전달 시 get() 오류 방지 — whereIn 복합쿼리에서
    //          request.query.filters.businessId가 null 반환 시 isAdminOf(null) 오류로
    //          PERMISSION_DENIED가 발생하던 문제를 early-return으로 차단
    // [W49:90 FIX] null 타입 경고 제거 — let biz = ... : null 대신 exists() 분리 패턴.
    //              isLoggedIn()을 exists() 앞으로 이동해 미인증 요청 시 Firestore 읽기 생략.
    function isAdminOf(businessId) {
      let valid = businessId is string && businessId.size() > 0;
      return valid &&
        isLoggedIn() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.get('ownerId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.get('adminIds', {})
        );
    }
    function isSubAdminOf(businessId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return businessId is string && businessId.size() > 0 &&
        isLoggedIn() &&
        u != null &&
        u.data != null &&
        u.data.get('subAdminOf', '') == businessId;
    }

    // 하위 관리자인지 (특정 businessId 무관, subAdminOf 필드 존재 여부만 확인)
    function isSubAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isLoggedIn() && u != null && u.data != null &&
        u.data.get('subAdminOf', '') != '';
    }

    // [SEC-04] u == null 시 true 반환 → 블랙리스트 우회 가능 취약점 수정
    // 회원가입 시 users 문서가 항상 생성되므로 u == null은 비정상 케이스 → false 반환
    function isNotBlacklisted() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null && u.data.get('isBlacklisted', false) == false;
    }

    // [SCR-BL] 블랙리스트 + businessId 소속 검증을 단일 get()으로 통합
    // schedule_change_requests create 규칙에서 동일 경로 2회 get() 대신 사용
    function isValidSCRCreator(businessId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null &&
        u.data.get('isBlacklisted', false) == false &&
        businessId is string && businessId.size() > 0 &&
        u.data.get('businessId', '') == businessId;
    }

    // [SEC-05] 노쇼 누적 이용 제한(restrictedUntil) 서버 검증
    // 클라이언트 체크만 있으면 앱 조작으로 우회 가능 — Firestore 규칙 레벨에서 차단
    function isNotRestricted() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let until = u != null && u.data != null ? u.data.get('restrictedUntil', null) : null;
      return until == null || request.time > until;
    }

    // ═══════════════════════════════════════════════════════════

    // tos 서브컬렉션 write 권한 — get(/tos/$(toId)) 1회만 호출해 get() 비용 절감
    // 이전: isAdminOf(get(tos)) || isSubAdminOf(get(tos)) → get() 2회 → 1회로 줄임
    function isToAdmin(toId) {
      let to = get(/databases/$(database)/documents/tos/$(toId));
      return to != null && to.data != null && (
        isAdminOf(to.data.get('businessId', '')) ||
        isSubAdminOf(to.data.get('businessId', ''))
      );
    }

    // payroll_summaries 부모 문서 businessId 기반 관리자 검증
    // [NULL-CRASH-FIX 2026-07-16] get().data 직접 접근 → null crash 방지 (isToAdmin() 동일 패턴)
    function isPayrollSummaryAdmin(summaryId) {
      let s = get(/databases/$(database)/documents/payroll_summaries/$(summaryId));
      return s != null && s.data != null && (
        isAdminOf(s.data.get('businessId', '')) ||
        isSubAdminOf(s.data.get('businessId', ''))
      );
    }

    // USER_TO_BUSINESS 리뷰 requestId 소유권 검증
    // [SEC-RR-WORKER-OWN 2026-07-17] review_requests.workerId == uid 강제
    //   onDocumentCreated에서 auth context 없어 CF 검증 불가 → rules 레벨 강제
    // [H-1 수정 2026-07-17] bizId 파라미터 추가 — requestId.businessId 교차검증
    //   이전: workerId만 검증 → 근무자가 A사 requestId + businessId=B로 리뷰 생성 시 B사 평점 오염 가능
    function isReviewRequestOwnedBy(requestId, uid, bizId) {
      let rrDoc = get(/databases/$(database)/documents/review_requests/$(requestId));
      let rr = rrDoc != null && rrDoc.data != null ? rrDoc.data : null;
      return rr != null && rr.get('workerId', '') == uid && rr.get('businessId', '') == bizId;
    }

    // 멤버 초대 유효성 검증: pending 상태 + 대상 일치 + 30일 이내
    // [MEDIUM-01] 클라이언트 만료 필터링(30일)을 Firestore 규칙 레벨에서 보강
    //   get() 1회로 4개 조건을 한 번에 검증 (기존 3회 반복 호출 통합)
    function isValidPendingInvitation(invId, uid, bizId) {
      // [C-1 수정 2026-07-14] null.data 접근 방지 — 문서 미존재 시 get()이 null 반환 → .data 접근 오류
      // 기존: let inv = get(...).data; → null.data → PERMISSION_DENIED (보안상 무해하나 의도와 다름)
      let invDoc = get(/databases/$(database)/documents/member_invitations/$(invId));
      let inv = invDoc != null && invDoc.data != null ? invDoc.data : null;
      return inv != null &&
        inv.targetUid == uid &&
        inv.businessId == bizId &&
        inv.status == 'pending' &&
        inv.createdAt > request.time - duration.value(30, 'd') &&
        // [SEC-MEMBER-PERM] permissions는 초대장에 정의된 값과 일치 강제 — 초대 수락 시 권한 위조 차단
        //   공격: REST API로 permissions:{canManageWage:true,...} 포함해 create → UI 레이어 권한 위조
        request.resource.data.get('permissions', {}) == inv.get('permissions', {});
    }

    // ╔═══════════════════════════════════════════════════════════╗
    // ║  [해결 완료] whereIn 폴백 패턴 근본 수정                       ║
    // ╠═══════════════════════════════════════════════════════════╣
    // ║                                                           ║
    // ║  기존 문제: Firestore whereIn/복합 쿼리에서                    ║
    // ║    request.query.filters.businessId → null 반환            ║
    // ║    → isAdminOf(null) → PERMISSION_DENIED                  ║
    // ║    → 우회를 위해 isAdminOf(user.businessId) 폴백 추가         ║
    // ║    → 폴백이 타 사업장 쿼리에서도 통과하는 보안 허점              ║
    // ║                                                           ║
    // ║  수정 내용 (whereIn → 단건 병렬 쿼리 + businessId 필터):      ║
    // ║    to_firestore.dart  attendance/scr/contracts cleanup     ║
    // ║    to_firestore.dart  applications slotId 마감/삭제         ║
    // ║    contract_service.dart  getContractStatusBatch           ║
    // ║    close_management_dialog.dart  attendance 조회            ║
    // ║                                                           ║
    // ║  폴백 라인은 모든 컬렉션에서 제거됨.                           ║
    // ║  각 list 규칙은 isAdminOf(filters.businessId) 단독으로 동작.  ║
    // ╚═══════════════════════════════════════════════════════════╝

    // users 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {

      // get: 본인·슈퍼어드민은 전체, 사업장관리자·하위관리자는 근무자(USER)만 조회
      // (타 관리자의 FCM 토큰·은행계좌 등 민감정보 교차 접근 방지)
      allow get: if isLoggedIn() && (
                   isOwner(userId) ||
                   isSuperAdmin() ||
                   ((isBusinessAdmin() || isSubAdmin()) && resource.data.get('role', '') == 'USER')
                 );

      // 쿼리(LIST):
      //   limit=1: 로그인 여부 무관 허용
      //     - 회원가입 중복 체크 (username/phone/foreignIdNumber/businessNumber)
      //     - 관리자 멤버 초대 시 전화번호 검색 (findUserByPhone)
      //     - 아이디 찾기, 비밀번호 재설정
      //   SUPER_ADMIN: 무제한 (운영 도구)
      // [RESOLVED MED-02] whereIn(FieldPath.documentId) 대량 쿼리 →
      // [M-3] limit<=1 비인증 예외 제거 — callableCheckUsername/callableCheckForeignIdExists/callableFindUsername CF 이전 완료
      //   비인증 클라이언트가 limit<=1 쿼리로 users 전체 문서(PII) 접근 가능하던 취약점 차단.
      allow list: if isLoggedIn() && isSuperAdmin();

      // 슈퍼관리자: 일반 운영 필드 수정 가능 (최우선 — 운영 긴급 수정용)
      // [특이사항] Firestore Rules는 어느 allow 하나라도 true면 허용(OR)이므로 순서가 보안에는 영향 없음.
      // isSuperAdmin()을 최상단에 두어 다른 조건(isOwner 등)과 의도하지 않은 교차 해석을 방지.
      // [H-2~H-4] 블랙리스트·제재·신뢰도 필드는 감사 로그 무결성을 위해 CF Admin SDK 전용으로 차단.
      //   callableUnblacklistUser / callableResetPenalty / callableAdjustTrustScore CF 경유 필수.
      //   blacklistedBy·unblacklistedBy 등 audit trail 필드를 클라이언트가 직접 쓰면
      //   수행자 UID 위조가 가능하므로 서버에서 callerUid(검증된 값)로만 기록.
      allow update: if isSuperAdmin() &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         // [M-1] role — callableUpdateUserRole CF 전용 (감사 로그 무결성)
                         //   슈퍼어드민이 직접 role 변경 시 감사 로그 없이 권한 상승 가능
                         'role',
                         'isBlacklisted', 'blacklistReason',
                         'blacklistedBy', 'blacklistedAt',
                         'unblacklistedBy', 'unblacklistedAt',
                         'noShowCount', 'restrictedUntil',
                         'restrictionReleasedBy', 'restrictionReleasedAt',
                         'trustScore', 'trustScoreAdjustedBy', 'trustScoreAdjustedAt',
                         // [V11-FIX] badges — CF onReviewCreated/callableAdjustTrustScore 전용
                         //   슈퍼어드민이 직접 write 시 리뷰 기반 자격 조건 검증 없이 임의 배지 부여 가능
                         'badges',
                         // [HIGH-1 수정 2026-07-15] SEC-03 코멘트 명시 필드 차단 목록 누락
                         //   callableReportLate / callableAdjustTrustScore / applyRestartProgram CF 전용
                         //   슈퍼어드민 클라이언트가 lateCount 초기화 시 TrustScore 패널티 이력 삭제 효과 발생
                         'lateCount', 'totalWorkDays', 'lastRestartAt'
                       ]);

      // 본인 문서 수정 (role·isBlacklisted·subAdminOf·businessId·신뢰도 관련 필드 변경 차단)
      // subAdminOf는 CF trigger 전용, trustScore/noShowCount/lateCount/totalWorkDays는 관리자 또는 CF 전용
      // restrictedUntil: 제재 만료 시각 — 본인이 삭제하여 제재 우회 방지
      // SEC-77: businessId 차단 추가 — 변경 시 소속 교차검증을 우회해 타 사업장에
      //   attendance/schedule_change_requests 등 생성 가능 (CF Admin SDK·관리자 경로만 변경 허용)
      // SEC-78: isAdmin(레거시 필드) 추가 — 본인이 관리자 플래그 직접 설정 차단
      // SEC-79: sealBase64 추가 — 본인이 인감 이미지를 위조 URL로 교체해 계약서 위변조 차단
      // [HIGH-01] accountStatus 등 외국인 승인 관련 필드 추가 — 본인이 accountStatus를
      //   pending → active로 직접 변경해 슈퍼관리자 승인을 우회하는 취약점 차단
      // SEC-79b: ci/ciHash/passVerifiedAt — create에서 null 강제(L238)이나 update는 미차단 상태였음.
      //   USER가 타인의 CI 토큰을 본인 문서에 등록해 중복 가입 차단 우회 가능한 취약점 차단.
      //   PASS 인증은 CF Admin SDK(callableVerifyPass 예정)에서만 ci를 저장.
      //   settings_screen.dart의 클라이언트 직접 저장 코드는 다날 계약 후 CF 경로로 대체 필요.
      allow update: if isLoggedIn() &&
                       isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'role', 'isBlacklisted', 'subAdminOf', 'businessId',
                         // [RULE-FIX-M1] 블랙리스트 감사 필드 차단 추가 — 본인이 사유·집행자·일시 위조 차단
                         'blacklistReason', 'blacklistedBy', 'blacklistedAt',
                         'unblacklistedBy', 'unblacklistedAt',
                         'trustScore', 'noShowCount', 'lateCount', 'totalWorkDays', 'lastRestartAt',
                         'restrictedUntil', 'isAdmin', 'sealBase64',
                         'accountStatus', 'rejectionReason', 'approvedBy', 'approvedAt',
                         'rejectedBy', 'rejectedAt',
                         'ci', 'ciHash', 'passVerifiedAt',
                         // [SEC-107] CF onReviewCreated/updateUserReviewStats 전용 필드 차단
                         //   클라이언트가 직접 위조 시 배지 자격 조건 우회·신뢰도 통계 오염 가능
                         'averageRating', 'reviewCount', 'rehireRate', 'totalWorkHours',
                         // [SEC-109] CF resetPasswordWithCode가 관리하는 비밀번호 이력
                         //   클라이언트 직접 삭제 시 비밀번호 재사용 이력 무력화 가능
                         'passwordHistory',
                         // [M-1] badges — CF onReviewCreated/뱃지 자격 검증 전용
                         //   클라이언트 직접 삽입 시 자격 조건 우회 가능
                         'badges',
                         // [D1] termsConsentAt/termsConsent — CF callableRecordTermsConsent 전용
                         //   클라이언트 직접 설정 시 동의 일시 위조 가능 (법적 타임스탬프 Charter 위반)
                         'termsConsentAt', 'termsConsent',
                         // [HIGH-01] isIdVerified/idCardVerifiedAt — CF callableMarkIdCardVerified/callableDeleteIdCard 전용
                         //   클라이언트 직접 true 설정 시 OCR 없이 신분증 인증 우회 가능
                         //   (신분증 인증 결과가 단기공고 지원 자격 기준으로 사용됨)
                         'isIdVerified', 'idCardVerifiedAt',
                       ]);

      // [SEC-03 완료] trustScore·noShowCount·lateCount·totalWorkDays·restrictedUntil·lastRestartAt
      // 은 CF Admin SDK 전용 — 클라이언트(슈퍼어드민 포함) 직접 write 차단 (위 isSuperAdmin 규칙에서도 차단).
      // 처리 경로:
      //   - totalWorkDays: onAttendanceWageStatusChanged CF 트리거 (wageConfirmed 전환)
      //   - noShowCount·restrictedUntil: callableApplyNoShowPenalty CF (당일 취소) 또는
      //                                  onAttendanceWageStatusChanged CF 트리거 (status=NO_SHOW)
      //                                  또는 callableResetPenalty CF (슈퍼어드민 수동 해제)
      //   - lateCount·trustScore: callableReportLate CF (지각 처리)
      //                           또는 callableAdjustTrustScore CF (슈퍼어드민 수동 조정)
      //   - lastRestartAt: applyRestartProgram CF
      //   - isBlacklisted: callableBlacklistUser / callableUnblacklistUser CF (슈퍼어드민 전용)

      // BUSINESS_ADMIN이 자기 사업장 멤버 제거 시 subAdminOf 삭제만 허용 (설정은 CF trigger 전용)
      // subAdminOf 지정(CF Admin SDK)·전체 수정(isSuperAdmin)은 위 최상단 규칙에서 처리
      allow update: if isLoggedIn() &&
                       isBusinessAdmin() &&
                       isAdminOf(resource.data.get('subAdminOf', '')) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subAdminOf']) &&
                       !('subAdminOf' in request.resource.data);

      // [BIZ-CREATE-FIX] 사업장 등록 시 BUSINESS_ADMIN이 managedBusinessIds 업데이트 허용
      // 조건: (1)본인 문서 (2)BUSINESS_ADMIN (3)managedBusinessIds만 변경
      //       (4)H-06: 기존 배열보다 정확히 1개 증가만 허용 (제거·임의 교체 차단)
      //       (5)[HIGH-10-FIX] 추가된 businessId가 실제 본인 소유/관리 사업장인지 isAdminOf 검증
      //          → 타사 businessId 주입으로 managedBusinessIds 오염 공격 차단
      allow update: if isLoggedIn() &&
                       isOwner(userId) &&
                       isBusinessAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['managedBusinessIds']) &&
                       request.resource.data.managedBusinessIds.size() ==
                         resource.data.get('managedBusinessIds', []).size() + 1 &&
                       isAdminOf(request.resource.data.managedBusinessIds
                         .removeAll(resource.data.get('managedBusinessIds', []))[0]);

      // 회원가입(본인) 또는 관리자 더미 데이터 생성
      // [RULE-01] 더미 생성 시 민감 필드 차단 — role/isBlacklisted/sealBase64 등 초기값으로 심으면
      //           후속 논리 오동작 및 권한 상승에 악용 가능
      // [AUTH-H1/M6 FIX] 보안 의도는 유지하되 접근 방식 수정:
      //   이전: !hasAny([role, accountStatus, ...]) 로 키 자체를 차단
      //         → UserModel.toMap()이 이 필드들을 기본값으로 항상 포함해 전송하므로
      //           실제 회원가입이 전면 PERMISSION_DENIED 발생 (치명적 회귀)
      //   현재: 진짜 서버 전용 필드만 키 자체를 차단,
      //         나머지는 키 존재를 허용하되 초기 안전값으로만 제한
      //         → 권한 상승·우회 차단 유지 + 정상 회원가입 허용
      allow create: if isLoggedIn() && (
                      (isOwner(userId) &&
                       // 아예 키 존재 자체를 차단: 앱 로직에서도 사용하지 않는 서버 전용 필드
                       !request.resource.data.keys().hasAny([
                         'isAdmin',
                         'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt',
                       ]) &&
                       // sealBase64: UserModel.toMap()이 항상 포함(null)하므로 키 차단 불가 → 값 제한
                       request.resource.data.get('sealBase64', null) == null &&
                       // 키 존재는 허용, 초기 안전값만 허용 — 권한 상승·우회 차단
                       // role: SUPER_ADMIN 승격 차단 (USER/BUSINESS_ADMIN만 허용)
                       request.resource.data.get('role', 'USER') in ['USER', 'BUSINESS_ADMIN'] &&
                       // accountStatus: 슈퍼관리자 승인 우회 차단
                       request.resource.data.get('accountStatus', 'active') in ['active', 'pending'] &&
                       // [SEC-102] foreignIdNumber(외국인 등록번호)가 실제 값이 있으면 pending만 허용
                       // UserModel.toMap()은 항상 foreignIdNumber 키를 포함(null 가능)하므로
                       // 키 존재 여부가 아닌 값 null 여부로 판단
                       (request.resource.data.get('foreignIdNumber', null) == null ||
                        request.resource.data.get('accountStatus', 'pending') == 'pending') &&
                       // isBlacklisted: 신규 계정은 false만 허용
                       request.resource.data.get('isBlacklisted', false) == false &&
                       // CI 비밀값: 클라이언트 직접 설정 불가 (CF Admin SDK 전용)
                       request.resource.data.get('ci', null) == null &&
                       request.resource.data.get('ciHash', null) == null &&
                       // 사업장·하위관리자 소속: 가입 시 미배정만 허용 (CF trigger 전용)
                       request.resource.data.get('subAdminOf', null) == null &&
                       request.resource.data.get('businessId', null) == null &&
                       // managedBusinessIds: 가입 시 빈 배열만 허용 (사업장 등록은 별도 update 경로)
                       request.resource.data.get('managedBusinessIds', []).size() == 0 &&
                       // 제재·신뢰도: 초기 미설정만 허용 (CF Admin SDK 전용)
                       request.resource.data.get('restrictedUntil', null) == null &&
                       request.resource.data.get('lastRestartAt', null) == null &&
                       request.resource.data.get('trustScore', null) == null &&
                       request.resource.data.get('rejectionReason', null) == null &&
                       // 통계 카운터: 초기값 0만 허용 (CF Admin SDK 전용)
                       request.resource.data.get('noShowCount', 0) == 0 &&
                       request.resource.data.get('lateCount', 0) == 0 &&
                       request.resource.data.get('totalWorkDays', 0) == 0 &&
                       // [HIGH-U1] passVerifiedAt: CF callableVerifyPass 전용 (PASS 인증 위조 차단)
                       request.resource.data.get('passVerifiedAt', null) == null &&
                       // [HIGH-U2] isIdVerified/idCardVerifiedAt: CF callableMarkIdCardVerified 전용
                       //   CREATE 시 true 설정으로 신분증 인증 OCR 우회 차단
                       request.resource.data.get('isIdVerified', false) == false &&
                       request.resource.data.get('idCardVerifiedAt', null) == null &&
                       // [HIGH-U3] termsConsentAt/termsConsent: CF callableRecordTermsConsent 전용
                       //   법적 타임스탬프 위조 차단 (Trust Boundary Charter)
                       request.resource.data.get('termsConsentAt', null) == null &&
                       request.resource.data.get('termsConsent', null) == null &&
                       // [MEDIUM-U4] 리뷰 통계: CF onReviewCreated/updateUserReviewStats Admin SDK 전용
                       // averageRating/rehireRate는 UserModel.toMap()이 기본값 0.0을 항상 포함하므로 null|0 모두 허용
                       (request.resource.data.get('averageRating', null) == null || request.resource.data.get('averageRating', null) == 0) &&
                       request.resource.data.get('reviewCount', 0) == 0 &&
                       (request.resource.data.get('rehireRate', null) == null || request.resource.data.get('rehireRate', null) == 0) &&
                       request.resource.data.get('totalWorkHours', 0) == 0 &&
                       // [MEDIUM-U5] badges: CF onReviewCreated 자격 검증 전용
                       request.resource.data.get('badges', []).size() == 0
                      ));

      allow delete: if isSuperAdmin();

      // ─── users/{userId}/notifications 서브컬렉션 ─────────────
      // create: CF createNotification Callable(Admin SDK)로 단일화 — 클라이언트 직접 write 차단
      //   → 악의적 사용자가 타인에게 임의 알림을 발송하는 취약점 해소
      // read/delete: 본인 경로만 허용 (소유권 유지)
      // [SEC-14] update는 isRead·readAt 2개 필드만 허용
      //   — 클라이언트가 title/body/deepLink 등 알림 내용을 변조하는 취약점 차단
      match /notifications/{notificationId} {
        allow read: if isLoggedIn() && isOwner(userId);
        allow create: if false;
        // [LOW-FIX 29차] readAt 서버타임스탬프 강제 — 읽은 시각 과거/미래 조작 차단
        allow update: if isLoggedIn() && isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['isRead', 'readAt']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt']) ||
                         request.resource.data.readAt == request.time);
        allow delete: if isLoggedIn() && isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════
    // businesses 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /businesses/{businessId} {

      // 읽기: 해당 사업장 관리자·슈퍼어드민·지원자(신청한 TO의 사업장 정보 확인용)
      // 공개 정보(이름·주소·평점)는 로그인 사용자 전체 허용
      // [분리 완료] sealBase64(인감)는 businesses 문서에서 제거 → users/{uid}에만 저장.
      // 현재 businesses 문서에 남은 민감 필드: adminIds(관리자 UID 목록), ownerId(소유자 UID).
      // adminIds는 getMyBusiness() arrayContains 쿼리에 필수이므로 서브컬렉션 분리 불가.
      // UID 자체는 개인 식별 불가 — 현재 위험 수준은 낮다고 판단.
      allow get: if isLoggedIn();
      // [CF 이전 완료] getMyBusiness → callableGetMyBusiness CF로 이전
      // BUSINESS_ADMIN/SUB_ADMIN의 직접 list 쿼리 구조적 차단 (adminIds 덤프 방지)
      allow list: if isLoggedIn() && isSuperAdmin();

      // 슈퍼어드민은 ownerId/adminIds 조건 없이 사업장 생성 가능 (타 관리자 대신 등록 포함)
      // 일반 관리자는 본인 ownerId이고 adminIds에 본인 uid만 포함
      // [SEC-89] isApproved 서버 강제: 클라이언트가 직접 isApproved=true로 생성해 승인 절차 건너뜀 차단
      // [SEC-90] adminIds 초기값 제한: 창설자 UID 외 임의 UID 삽입 차단 (비동의 관리자 권한 부여 방지)
      // [RATE-01] 사업장 생성 개수 제한: managedBusinessIds 5개 초과 시 차단
      //   미승인 더미 사업장 남발로 Firestore 스토리지·관리자 검토 부담 방지
      //   배치 내 users 문서 업데이트 전 현재 배열 길이 기준으로 평가됨 (원자 카운팅)
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      (isBusinessAdmin() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.adminIds &&
                       request.resource.data.adminIds.hasOnly([request.auth.uid]) &&
                       request.resource.data.get('isApproved', false) == false &&
                       // [HIGH-B1] rating/reviewCount: CF updateBusinessReviewStats Admin SDK 전용
                       //   CREATE 시 허위 평점 초기값 설정으로 구직자 기만 차단
                       request.resource.data.get('rating', 0) == 0 &&
                       request.resource.data.get('reviewCount', 0) == 0 &&
                       // [LOW-1 수정 2026-07-15] 사업자등록번호 10자리 숫자 포맷 서버 검증
                       request.resource.data.get('businessNumber', '').matches('[0-9]{10}') &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid))
                         .data.get('managedBusinessIds', []).size() < 5)
                    );

      // [특이사항] ownerId/adminIds 변경은 슈퍼어드민만 허용.
      // BUSINESS_ADMIN이 ownerId를 자신으로 변경하거나 다른 관리자를 adminIds에서 제거해
      // 사업장 소유권을 탈취하는 권한 모독 공격 방지.
      // isApproved: 슈퍼관리자 승인 절차 우회 차단 (직접 true 설정으로 미승인 사업장 활성화 방지)
      // deactivatedAt: 기본적으로 차단 — 단, 단독 관리자 탈퇴 시 예외 허용 (SEC-95)
      //   단독 관리자(adminIds.size() <= 1)가 deactivatedAt 필드만 설정하는 경우 허용.
      //   이중 관리자 이상인 경우 차단 유지 (외부 비활성화 공격 방어).
      allow update: if (isAdminOf(businessId) || isSuperAdmin()) &&
                    // [V9-FIX] 법적 상태·감사 추적 — callableManageBusiness CF 전용
                    //   슈퍼어드민 직접 쓰기도 차단 (CF Admin SDK가 우회하여 씀)
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['isApproved', 'approvedBy', 'deactivatedBy', 'reactivatedBy']) &&
                    (isSuperAdmin() ||
                     (!request.resource.data.diff(resource.data).affectedKeys()
                        // [SEC-108] rating/reviewCount: CF updateBusinessReviewStats Admin SDK 전용
                        //   관리자가 직접 평점 위조 시 USER들이 허위 평판 사업장을 신뢰하는 피해 발생
                        .hasAny(['ownerId', 'adminIds', 'approvedAt',
                                 'deactivatedAt', 'reactivatedAt', 'rating', 'reviewCount',
                                 // [M-4 수정 2026-07-17] businessNumber 불변 — 승인 후 사업자번호 변경 차단
                                 'businessNumber']) ||
                      (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['deactivatedAt']) &&
                       resource.data.get('adminIds', []).size() <= 1)));
      // [SEC-100] 공동 관리자 탈퇴: 본인 uid만 adminIds에서 제거 허용 (별도 규칙)
      // 기존 update 규칙에서 adminIds 변경을 차단하므로 별도 경로 필요.
      // 조건: adminIds 필드만 변경 + 결과에서 본인이 제거됨 + 정확히 1명만 제거
      //   → 타인 uid 제거, 여러 명 일괄 제거, 관계없는 필드 동시 변경 모두 차단.
      allow update: if isAdminOf(businessId) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['adminIds']) &&
                    !(request.auth.uid in request.resource.data.get('adminIds', [])) &&
                    resource.data.get('adminIds', []).size() ==
                      request.resource.data.get('adminIds', []).size() + 1;
      // [E-1 수정 2026-07-14] 공동 관리자 전체 사업장 삭제 차단 — ownerId만 허용
      // 기존: isAdminOf (adminIds 전체) → 공동 관리자가 사업장 문서 삭제 가능
      // tos/attendance/applications 등 하위 데이터가 cascade 없이 orphan 잔존, 부분 복구만 가능
      allow delete: if (isAdminOf(businessId) && resource.data.ownerId == request.auth.uid) || isSuperAdmin();

      match /workTypes/{workTypeId} {
        allow read: if isLoggedIn();
        // [M-5 수정 2026-07-17] write 통합 → create/update/delete 분리
        //   update 시 businessId 불변 보장 — 다른 사업장 workType으로 재귀속 공격 차단
        allow create: if isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin();
        allow update: if (isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin()) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['businessId']);
        allow delete: if isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin();
      }

      match /contract_templates/{templateId} {
        // [SEC-106] 소속 관리자/서브어드민/슈퍼어드민으로 제한
        // 이전: isLoggedIn() — 타 사업장 관리자도 businessId만 알면 임금 구조·계약 조건 열람 가능
        // 근무자는 employment_contracts 문서를 통해 계약 내용을 열람하므로 직접 접근 불필요
        allow read: if isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin();
        // SEC-78: write 단일 규칙 → create/update/delete 분리
        // update 시 수정 가능 필드 화이트리스트 — businessId·createdAt 불변 보장
        // (ContractTemplateModel.copyWith: name·templateType·articles·updatedAt만 편집 허용)
        // [SEC-CT-BIZ] create 시 문서 내 businessId가 URL 경로 businessId와 일치 강제
        //   공격: A 사업장 관리자가 A 경로에 {businessId:'B'} 문서 생성 → B 사업장 계약서로 오귀속
        allow create: if (isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin()) &&
          (isSuperAdmin() ||
           request.resource.data.get('businessId', '') == businessId);
        allow update: if (isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin()) &&
          (isSuperAdmin() ||
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'templateType', 'articles', 'updatedAt']));
        allow delete: if isAdminOf(businessId) || isSubAdminOf(businessId) || isSuperAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // tos 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /tos/{toId} {

      // get: 공개 TO는 로그인 사용자 전체, 비공개 TO는 관리자만
      // [S-M3-FIX] 비공개(미출판) TO 임금·인원 정보 비인가 접근 차단
      // list 규칙 주석(SEC-47)에서 "get 규칙에서 isPublished 검증"을 명시했으나 누락되어 있었음
      allow get: if isLoggedIn() && (
        isSuperAdmin() ||
        isAdminOf(resource.data.businessId) ||
        isSubAdminOf(resource.data.businessId) ||
        resource.data.get('isPublished', false) == true
      );
      // list: [CF-이전 완료 2026-07-13] callableGetTOsByBiz로 관리자 직접 쿼리 전량 이전
      //   business_admin_home_screen·work_type_management_screen·auth_service·settings_screen
      //   isBusinessAdmin()/isSubAdmin() 제거 완료 — 관리자 리스트 조회는 CF Admin SDK 경유
      allow list: if isLoggedIn() && (
        isSuperAdmin() ||
        // SEC-47: isPublished 필터는 앱 코드(getPublishedTOs)에서 강제 — limit <= 50 제한 유지
        // [FILTERS-BROKEN] request.query.filters는 Firestore list 쿼리에서 null 반환 (미문서 프로퍼티)
        // 미공개 TO는 초안 상태로 민감도 낮음. 개별 get 규칙은 isPublished==true 강제 유지.
        (isUser() && request.query.limit <= 50)
      );

      // [HIGH-02] TO 생성은 callableCreateTO CF(Admin SDK)로만 허용 — 클라이언트 직접 create 차단
      // CF에서 개수 제한 검증 + serverTimestamp 강제. 클라이언트가 개수 제한을 우회할 수 없도록 함.
      allow create: if false;

      // [CF-이전 2026-07-14] callableUpdateTO — 관리자/하위관리자 직접 write 차단
      //   이전 이유: reopenedBy/closedBy 감사 필드 위조 가능, updatedBy 감사 로그 없음
      //   callableUpdateTO CF(Admin SDK)가 assertBizAdmin + 필드 검증 + 감사 로그 처리
      //   슈퍼어드민은 긴급 운영 수정 시 직접 write 허용 (동일 보호 조건 유지)
      allow update: if isSuperAdmin() &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['businessId']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                        request.resource.data.status in ['ACTIVE', 'FULL', 'CLOSED', 'EXPIRED', 'DRAFT', 'SCHEDULED'])
                    // [SLOT-SYNC 2026-07-15] 슬롯 수정 시 totalRequired 집계 동기화 예외
                    //   CF 이전 이유(감사 필드 위조·updatedBy 로그)와 무관한 순수 집계 파생 필드.
                    //   updateSlotFull/saveBatchSlotChanges에서 slots update와 함께 tos.totalRequired를
                    //   클라이언트 SDK 트랜잭션/배치로 increment할 때 PERMISSION_DENIED 발생 차단.
                    //   totalRequired만 변경하는 경우에 한해 isToAdmin 허용.
                    || (isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalRequired']) &&
                        request.resource.data.totalRequired >= 0)
                    // [SLOT-ADD 2026-07-15] 슬롯 추가(addSlot) 시 TO 집계 필드 업데이트 예외
                    //   addSlot()은 totalSlots+totalRequired 동시 increment + 날짜 범위 갱신
                    //   (rangeStart/rangeEnd) + 마감 TO 자동 복구(status=ACTIVE, isPublished, statusUpdatedAt).
                    //   감사 필드(closedBy/reopenedBy/updatedBy 등) 미포함 → 보안 위험 없음.
                    //   status 변경은 ACTIVE 복구로만 제한 (CLOSED/FULL/EXPIRED 설정 불가).
                    // [LOW-2 수정 2026-07-16] totalRequired/totalSlots 음수 허용 방지
                    || (isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['totalSlots', 'totalRequired', 'status', 'isPublished',
                                    'statusUpdatedAt', 'rangeStart', 'rangeEnd']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                         request.resource.data.status == 'ACTIVE') &&
                        // [SEC-SLOT-PUBLISH] isPublished 단독 변경 차단:
                        // addSlot 진짜 호출이면 totalSlots+totalRequired 동시 변경 필수
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPublished']) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasAll(['totalSlots', 'totalRequired'])) &&
                        // [M14-FIX] DRAFT/SCHEDULED TO에서 공개 직접 전환 차단 (callablePublishTO 우회 방지)
                        // 예외: publishMode='deferred' TO는 슬롯 생성 완료 후 ACTIVE 전환이 하단 규칙에서 허용
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPublished', 'status']) ||
                         (resource.data.status != 'DRAFT' && resource.data.status != 'SCHEDULED')) &&
                        request.resource.data.get('totalRequired', 0) >= 0 &&
                        request.resource.data.get('totalSlots', 0) >= 0);

      // [DEFERRED-PUBLISH] flex 즉시공개 — 슬롯 생성 완료 후 SCHEDULED→ACTIVE 전환 허용
      // publishMode='deferred': deferPublish 전용 마킹 — 일반 SCHEDULED TO(callablePublishTO 경유)와 구별
      // status/isPublished/statusUpdatedAt 3개 필드만 허용 — 관리자 필드 위조 차단
      allow update: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                       resource.data.status == 'SCHEDULED' &&
                       resource.data.get('publishMode', '') == 'deferred' &&
                       request.resource.data.status == 'ACTIVE' &&
                       request.resource.data.get('isPublished', false) == true &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'isPublished', 'statusUpdatedAt']);

      // 지원자: 지원/취소 시 totalPending 카운터만 수정 허용 (음수 방지)
      // [MEDIUM-FIX] ±1 제한 없이 임의 양수값 설정 가능 → 통계 훼손 가능
      // request.resource.data.totalPending == resource.data.totalPending ± 1 로 변경폭 제한
      allow update: if isLoggedIn() && isUser() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['totalPending']) &&
                       request.resource.data.totalPending is int &&  // SEC-15: 타입 검증
                       request.resource.data.totalPending >= 0 &&
                       (request.resource.data.totalPending == resource.data.totalPending + 1 ||
                        request.resource.data.totalPending == resource.data.totalPending - 1);

      // [C-HIGH-FIX] USER의 totalConfirmed 직접 감소 규칙 제거
      // CF callableDecrementSlotConfirmed(Admin SDK)가 유일한 감소 경로 — 클라이언트 직접 쓰기 차단

      // SubAdmin도 공고 삭제 허용 (update에 있으나 delete에 누락)
      allow delete: if isLoggedIn() &&
                       (isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId) ||
                        isSuperAdmin());

      match /workDetails/{workDetailId} {
        // SEC-WD: 미발행 TO의 workDetails(임금 등 상세) 노출 차단 — slots와 동일한 isPublished 가드 적용
        //   관리자는 미발행 상태에서도 접근 허용 (TO 작성/검토 필요)
        //   일반 사용자는 부모 TO가 isPublished==true인 경우에만 허용
        allow read: if isLoggedIn() && (
                      isToAdmin(toId) || isSuperAdmin() || (
                        exists(/databases/$(database)/documents/tos/$(toId)) &&
                        get(/databases/$(database)/documents/tos/$(toId))
                          .data.get('isPublished', false) == true
                      )
                    );
        allow create, delete: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin());
        // [SEC-WD] businessId/toId 불변 — 부모-자식 관계 변조 차단 (슈퍼어드민 예외)
        allow update: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                        (isSuperAdmin() ||
                         !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['businessId', 'toId']));


      }

      match /slots/{slotId} {
        // SEC-83: 미발행 TO의 슬롯(임금정보 등) 노출 차단 — isPublished 상속 적용
        //   관리자는 미발행 상태에서도 접근 허용 (TO 작성/검토 필요)
        //   일반 사용자는 부모 TO가 isPublished==true인 경우에만 허용
        allow read: if isLoggedIn() && (
                      isToAdmin(toId) || isSuperAdmin() || (
                        exists(/databases/$(database)/documents/tos/$(toId)) &&
                        get(/databases/$(database)/documents/tos/$(toId))
                          .data.get('isPublished', false) == true
                      )
                    );
        // [RULE-SLOT-CREATE] create 시 카운터 초기값 강제 + status 화이트리스트
        //   관리자가 confirmedCount:999 또는 status:'closed'로 슬롯을 첫 생성하는 조작 차단
        allow create: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                        (isSuperAdmin() ||
                         (request.resource.data.get('confirmedCount', 0) == 0 &&
                          request.resource.data.get('pendingCount', 0) == 0 &&
                          (!request.resource.data.keys().hasAny(['status']) ||
                           request.resource.data.status in ['open', 'full', 'closed'])));
        allow delete: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin());
        // [SEC] confirmedCount ±1 제한 — 관리자도 임의 값으로 정원 조작 불가
        // Admin SDK CF(callableDecrementSlotConfirmed)는 rules 제외 — 소유권 검증 내장
        allow update: if isLoggedIn() && (isToAdmin(toId) || isSuperAdmin()) &&
                        // confirmedCount ±1 제한
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedCount']) ||
                         (request.resource.data.confirmedCount >= 0 &&
                          (request.resource.data.confirmedCount == resource.data.confirmedCount - 1 ||
                           request.resource.data.confirmedCount == resource.data.confirmedCount + 1))) &&
                        // [RULE-FIX-M2] pendingCount ±1 제한 — 관리자 경로 누락 보완
                        //   USER 경로는 ±1 제한 있었으나 isToAdmin 경로는 제한 없어 임의 값 삽입 가능했음
                        (isSuperAdmin() ||
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingCount']) ||
                         (request.resource.data.pendingCount >= 0 &&
                          (request.resource.data.pendingCount == resource.data.pendingCount - 1 ||
                           request.resource.data.pendingCount == resource.data.pendingCount + 1))) &&
                        // [RULE-FIX-M2] status 화이트리스트 — 임의 문자열 삽입 차단
                        (isSuperAdmin() ||
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                         request.resource.data.status in ['open', 'full', 'closed']);


        // [A1-FIX] 지원자: pendingCount 카운터만 수정 허용 (workTypeCounts 제거)
        // workTypeCounts 전체 맵 교체로 confirmedCount 조작 가능한 취약점 차단.
        // workTypeCounts.pendingCount는 callableIncrementSlotPending CF(Admin SDK)가
        // dot-notation으로 정밀 업데이트 — 전체 맵 교체 경로 완전 차단.
        allow update: if isLoggedIn() && isUser() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['pendingCount']) &&
                         request.resource.data.pendingCount >= 0 &&
                         (request.resource.data.pendingCount == resource.data.pendingCount + 1 ||
                          request.resource.data.pendingCount == resource.data.pendingCount - 1);
        // [SEC-FIX] USER confirmedCount 직접 감소 규칙 제거
        // 이유: USER가 application 없이 slot만 단독 호출해 정원 초과 지원 가능한 취약점
        // 해결: cancelConfirmedApplication의 _decrementTOConfirmed를 callableDecrementSlotConfirmed
        //       CF로 이전 (Admin SDK) — application_firestore.dart L1097-L1115 참조
        // 관리자의 confirmedCount 변경은 위 allow update(isToAdmin || isSuperAdmin) ±1 제한 적용됨
      }
    }

    // ═══════════════════════════════════════════════════════════
    // applications 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /applications/{applicationId} {

      // get: 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.uid) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );


      // list: [크로스-사업장 방지] 역할별 소속 사업장 또는 본인 uid 필터 적용
      //   · BUSINESS_ADMIN/SubAdmin: 소속 사업장 businessId 필터 (폴백: user.businessId)
      //   · USER: uid == auth.uid 단일 equality 필터 필수 — 타인 지원서 목록 열람 차단
      //   · whereIn 복합쿼리(getApplicationsByIds)는 filters.businessId null → user.businessId 폴백으로 처리
      // [HIGH-FIX] isUser() 단독 허용으로 전체 지원자 임금·계약·퇴사사유가 필터 없이 덤프 가능했던
      //            취약점 수정. USER 브랜치에 uid 필터 강제 추가.
      // [CF-이전 완료 2026-07-13] callableGetApplicationsByBiz로 관리자 직접 쿼리 전량 이전
      //   closeTOManually·_showWageGuardWarning CF 이전 완료
      //   deleteAccountWithPassword: BUSINESS_ADMIN 경로는 onBusinessDeactivated CF 위임,
      //     USER 경로는 uid 필터(isUser() 경로) → isBusinessAdmin()/isSubAdmin() 제거 완료
      allow list: if isLoggedIn() && (
                   isSuperAdmin()
                   // [CF-MIGRATED 2026-07-15] callableGetMyApplications CF 이전 완료
                   // USER 직접 list 차단 — 임금 데이터 노출 방지
                 );
      // [CF-ONLY] callableApplyToTO(Admin SDK) 이전 완료 2026-07-14.
      //   신규 지원(create)·재지원(update CANCELED→PENDING) 모두 CF에서 처리.
      //   클라이언트 직접 create 경로 전면 차단 — CF Admin SDK 전용.
      allow create: if false;

      allow update: if isLoggedIn() && (
                      // 지원 취소 (본인 PENDING → CANCELED): status/canceledAt/statusHistory만 허용
                      // [036] CONTRACT_PENDING 상태에서 취소 불가 — 관리자 개입 필요
                      (isOwner(resource.data.uid) &&
                       resource.data.status == 'PENDING' &&
                       request.resource.data.status == 'CANCELED' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'canceledAt', 'cancelReason', 'statusHistory']) &&
                       // [MEDIUM-4 수정 2026-07-15] canceledAt 서버타임스탬프 강제
                       //   과거 시각 위조로 callableApplyNoShowPenalty 48h 기준 우회 차단
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['canceledAt']) ||
                        request.resource.data.canceledAt == request.time)) ||
                      // [CF-ONLY] 확정 취소 (본인: CONFIRMED/CONTRACT_PENDING → CANCELED) — callableCancelConfirmedApplication CF(Admin SDK) 전용
                      // canceledBy 서버 강제(클라이언트 위조 차단) + statusHistory.at CF 서버 시간 강제
                      // 클라이언트 직접 전이 허용 규칙 삭제: schedule_card / apply_work_dialog 모두 CF로 전환됨

                      // [CF-ONLY] 재지원 (CANCELED/AUTO_CANCELED/REJECTED → PENDING) — callableApplyToTO(Admin SDK) 전용
                      //   클라이언트 직접 재지원 경로 차단: wage/startTime/endTime 등 핵심 계약 조건 임의 변경 위험
                      //   (기존: isOwner + isNotBlacklisted + hasOnly 목록 → false로 전환)
                      // false ||
                      // [CF-ONLY] 근로계약서 서명 완료 (CONTRACT_PENDING → CONFIRMED)
                      //   — callableFinalizeWorkerSignature(Admin SDK) 전용.
                      //   클라이언트 직접 전이 제거: CF에서 workerId 검증 + 계약서 서명 완료 확인 후 처리.
                      // [CF-ONLY] 퇴사 요청 제출 (resignStatus→PENDING) — callableRequestResignation(Admin SDK) 전용
                      // 클라이언트 직접 경로 제거: CF 이전 완료, 규칙에서 이중 경로 제거
                      // [CF-ONLY] 퇴사 요청 취소 (resignStatus→null) — callableCancelResignRequest(Admin SDK) 전용
                      // [CF-ONLY] 계약해지 수락 (terminationStatus→APPROVED) — callableApproveTermination(Admin SDK) 전용
                      // 관리자: uid·businessId·toId 불변
                      // slotId 허용 — 파트 변경 기능 (근무자를 다른 슬롯으로 이동)
                      // workDetailId 허용 — changeApplicationWorkType(파트 변경) 시 TO 내 다른 workDetail로 이동 필요
                      //   UI에서 현재 파트를 제외한 다른 파트만 선택 가능 (work_applicants_dialog.dart L1789)
                      //   원본 파트·임금은 originalWorkType/originalWage에 보존됨
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       // [CF-ONLY] 퇴사/계약해지 관련 필드 전체 차단 — 모든 상태 전이는 CF(Admin SDK)만 허용
                       // resignRejectedBy 등 audit trail 필드를 클라이언트가 위조하는 취약점 방지
                       // [RULE-FIX-M4] leaveDates/extraWorkDates CF-ONLY — callableCancelScheduleChangeRequest 이전 완료
                       //   관리자가 직접 임의 날짜 배열로 덮어쓰는 취약점 차단
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'businessId', 'toId',
                                  'resignStatus', 'resignRequestedAt', 'resignRequestDate',
                                  'resignApprovedAt', 'resignApprovedBy',
                                  'resignRejectedAt', 'resignRejectedBy', 'resignRejectReason',
                                  'actualResignDate',
                                  'terminationStatus', 'terminationRequestedAt',
                                  'terminationEffectiveDate', 'terminationRespondedAt',
                                  'terminationRejectReason', 'terminationRequestedByUid',
                                  'leaveDates', 'extraWorkDates',
                                  // [H-2-FIX] 감사 추적 필드 — CF(Admin SDK) 전용
                                  //   rejectedBy: callableRejectApplication CF가 callerUid로 강제
                                  //   canceledBy: callableCancelConfirmedApplication CF가 callerUid로 강제
                                  'rejectedBy', 'rejectedAt', 'canceledBy']) &&
                       // [RULE-FIX-M2] CF-ONLY 전이 차단: CONTRACT_PENDING→CONFIRMED
                       //   callableFinalizeWorkerSignature 전용 — 관리자 직접 전이 시 서명 검증 우회 가능
                       !(resource.data.status == 'CONTRACT_PENDING' &&
                         request.resource.data.status == 'CONFIRMED') &&
                       // [S6-FIX] PENDING→CONFIRMED 직접 전이 차단 — callableConfirmApplication CF(Admin SDK)만 허용
                       //   클라이언트 직접 전이 시 totalConfirmed 카운터 증가 없이 확정 상태 진입 가능
                       !(resource.data.status == 'PENDING' &&
                         request.resource.data.status == 'CONFIRMED') &&
                       // [CF-ONLY] PENDING→REJECTED 직접 전이 차단 — callableRejectApplication CF(Admin SDK) 전용
                       //   클라이언트가 rejectedBy에 다른 관리자 UID를 위조해 책임 전가하는 취약점 차단
                       //   statusHistory.at 클라이언트 기기 시간 조작도 동시 차단
                       !(resource.data.status == 'PENDING' &&
                         request.resource.data.status == 'REJECTED') &&
                       // [H-1-FIX] CONFIRMED/CONTRACT_PENDING → REJECTED 차단 — callableRejectApplication CF 전용
                       //   확정 상태 지원서를 직접 REJECTED로 전이 시 rejectedBy/statusHistory.at 위조 가능
                       !(resource.data.get('status', '') in ['CONFIRMED', 'CONTRACT_PENDING'] &&
                         request.resource.data.status == 'REJECTED') &&
                       // [CF-ONLY] CONFIRMED/CONTRACT_PENDING → CANCELED 차단 — callableCancelConfirmedApplication CF 전용
                       //   canceledBy 서버 강제 + statusHistory.at CF 서버 시간 + slot decrement 원자성
                       !(resource.data.get('status', '') in ['CONFIRMED', 'CONTRACT_PENDING'] &&
                         request.resource.data.status == 'CANCELED') &&
                       // [MEDIUM-1] CANCELED/AUTO_CANCELED/REJECTED → CONFIRMED/PENDING 직접 전이 차단
                       //   CONFIRMED: totalConfirmed CF 없이 확정 시 카운터 불일치
                       //   PENDING: callableApplyToTO 우회 — wage/startTime/endTime 재검증 누락
                       !(resource.data.get('status', '') in ['CANCELED', 'AUTO_CANCELED', 'REJECTED'] &&
                         request.resource.data.status in ['CONFIRMED', 'PENDING'])) ||
                      isSuperAdmin()
                    );

      // [HIGH-1] CONFIRMED/CONTRACT_PENDING 상태 지원서 삭제 차단
      //   삭제 시 totalConfirmed가 감소하지 않아 정원 관리 불일치 발생
      //   슈퍼어드민도 CF(callableDecrementSlotConfirmed)를 통해 처리해야 함
      //   [SEC-FIX] 이전 `isSuperAdmin() || (...)` 구조는 단락평가로 슈퍼어드민 상태 제한 우회 가능
      //   수정: 슈퍼어드민 포함 전원이 CONFIRMED/CONTRACT_PENDING 삭제 차단
      allow delete: if (isSuperAdmin() ||
                        isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       !(resource.data.get('status', '') in ['CONFIRMED', 'CONTRACT_PENDING']);
    }

    // ═══════════════════════════════════════════════════════════
    // attendance 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {

      // get: 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.userId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );


      // list: [CF 이전 완료 2026-07-17] 클라이언트 직접 list 쿼리 전면 차단
      //   관리자 경로 전환 목록:
      //   · getTodayAttendanceByBusiness / getAttendanceByDate / getWeeklyAttendanceByBusiness → callableGetAdminAttendances
      //   · payroll_overview_screen._loadYear / payroll_worker_detail_screen._loadRecords → callableGetAdminAttendances
      //   · admin_stats_service._queryAttendance → callableGetAdminAttendances
      //   · attendance_status_dialog._getAttendanceRecords → callableGetAdminAttendances
      //   · tax_deduction_service.getMonthlyWorkDays → callableGetAdminAttendances
      //   · payroll_payment_service.getPayrollRecords / getTodayPayments / getTodayPaymentCount → callableGetAdminAttendances
      //   · close_management_dialog → callableGetAttendanceForClosing CF (H-CF-1, 2026-07-16)
      //   · hasAttendanceRecord → callableAdminHasAttendanceRecord CF (H-CF-1, 2026-07-16)
      //   USER 경로 차단:
      //   · _cleanupApplicationRelatedData → callableCleanupApplicationData CF
      //   · 탈퇴 3-pre4 attendance 정리 → callableDeleteAccountApplications CF
      //   클라이언트 코드 전수 점검 — attendance WHERE/list 쿼리 0건 확인 (2026-07-17).
      //   CF Admin SDK는 rules 우회 → 모든 CF 호출 경로에 영향 없음.
      allow list: if false;




      // [B1-FIX] 근무자 본인 checkIn 클라이언트 직접 CREATE 경로 삭제
      // callableCheckIn CF(Admin SDK)로 완전 이전 완료 — CF가 소유권·휴무일·반올림을 서버에서 강제.
      // 이전 경로: request.resource.data.userId == request.auth.uid 기반 clients create
      // 삭제 이유: 클라이언트 시각·businessId·applicationId를 위조한 출근 기록 생성 가능 취약점 차단.
      //
      // 유지 경로:
      //   callableBatchCheckIn (관리자 수동 출근/배치 출근) — CF Admin SDK, rules 우회
      //   callableBatchSetNoShow (노쇼 신규 생성) — CF Admin SDK, rules 우회
      // 클라이언트 직접 create 경로 전면 차단 — CF Admin SDK 전용.
      allow create: if false;

      // wageStatus 역전환 방지: transferred 상태는 관리자/슈퍼어드민도 되돌릴 수 없음
      // [143] transferredBy 필드 변경 시 본인 UID만 허용 — 감사 추적 위변조 방지
      // [NOSHOW-FIX] 노쇼 상태로 변경 시 finalWage 0 강제
      // [B1-FIX] 근무자 checkOut 클라이언트 직접 UPDATE 경로 삭제
      //   callableCheckOut CF(Admin SDK)로 완전 이전 완료 — CF가 반올림·workHours를 서버에서 강제.
      //   이전 경로: isOwner + checkOut/workHours/status 필드 허용 블록
      //   유지 경로(근무자): canceledWithApplication, absent 전이만 허용 (isOwner 경유 잔존)
      allow update: if isLoggedIn() &&
                      !(request.resource.data.get('status', '') == 'NO_SHOW' &&
                        request.resource.data.get('finalWage', 0) != 0) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['transferredBy']) ||
                       request.resource.data.transferredBy == request.auth.uid) &&
                      // [V1-FIX] confirmedBy 필드 변경 시 본인 UID만 허용 — transferredBy와 동일 패턴
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedBy']) ||
                       request.resource.data.confirmedBy == request.auth.uid) &&
                      !(resource.data.wageStatus == 'transferred' &&
                        request.resource.data.wageStatus != 'transferred') &&
                      // [MEDIUM-1] transferred 직접 설정 차단 — SuperAdmin 포함 모든 클라이언트
                      // CF Admin SDK(callableMarkTransferredBatch) 경유만 허용
                      // [V5-FIX] confirmed 직접 설정 차단 — callableConfirmFinalWage CF(Admin SDK)로만 허용
                      // [V5-REV-FIX] calculated 직접 설정 차단 — callableCancelFinalConfirmation CF(Admin SDK)로만 허용
                      // [WORK-TYPE-CF] pending 직접 설정 차단 — callableWageCancel/callableChangeApplicationWorkType CF 전용
                      // [MEDIUM-5 수정 2026-07-15] 블랙리스트(4개) → 전체 차단으로 강화
                      //   모든 wageStatus 전이는 CF Admin SDK 경유 — 클라이언트가 'absent'·임의 값 삽입 시 payroll 집계 오동작
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wageStatus']) && (
                      // [C-1] 확정 취소 시 wageStatus=pending 출근기록 무효화
                      // cancelConfirmedApplication → _cleanupApplicationRelatedData(businessId=null)
                      // 에서 USER 컨텍스트로 호출. calculated/confirmed/transferred는 이미 위에서 차단됨.
                      // canceledWithApplication: false→true 단방향만 허용 (플래그 제거 차단)
                      (resource.data.wageStatus == 'pending' &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canceledWithApplication']) &&
                       request.resource.data.canceledWithApplication == true) ||
                      // [SEC-97] 탈퇴 처리: scheduled → absent 전이 + absentReason=USER_DELETED 허용
                      // 3-pre4 블록에서 본인(userId==auth.uid) 컨텍스트로 실행 — isOwner() 필요.
                      // wageStatus='pending' 상태의 예정 출근 기록만 허용(확정/정산된 기록 보호).
                      // absentReason 값을 'USER_DELETED'로 고정해 다른 사유로 임의 absent 설정 차단.
                      (resource.data.wageStatus == 'pending' &&
                       isOwner(resource.data.userId) &&
                       resource.data.get('status', '') == 'scheduled' &&
                       request.resource.data.get('status', '') == 'absent' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'absentReason', 'updatedAt']) &&
                       request.resource.data.get('absentReason', '') == 'USER_DELETED') ||
                      // [SEC-46] 관리자: 핵심 식별자 불변 조건 추가 — 출근 기록 재귀속 차단
                      // userId/businessId/applicationId/workDate는 생성 후 변경 불가 (슈퍼어드민 예외)
                      // wageDetail/finalWage/wageStatus 등 운영 필드는 wage_confirm_dialog 기능 유지
                      // [CF-이전] wageStatus: transferred 전환은 CF Admin SDK 전용 (callableMarkTransferredBatch)
                      //   → 클라이언트(관리자 포함)에서 transferred 직접 설정 차단
                      // [임금H-1] finalWage 음수 저장 차단 — 관리자 직접 API 호출로 임의 음수 급여 기록 방지
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['userId', 'businessId', 'applicationId', 'workDate',
                                  'checkInSuspicious', 'checkInDistance',
                                  // GPS 원본 시각은 관리자도 덮어쓸 수 없음
                                  'originalCheckIn', 'originalCheckOut',
                                  // [MEDIUM-6 수정 2026-07-15] yearMonth 불변 강제 — 급여 월별 집계 오삽입 차단
                                  'yearMonth']) &&
                       // confirmed→transferred 직접 전환 차단 — CF Admin SDK 경유만 허용
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['wageStatus']) ||
                        request.resource.data.get('wageStatus', '') != 'transferred') &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['finalWage']) ||
                        request.resource.data.get('finalWage', 0) >= 0) &&
                       // [M-1 수정 2026-07-17] transferred 상태 finalWage/wageDetail 소급 수정 차단
                       //   지급 완료된 임금은 변경 불가 — 급여 증빙 위변조 방지
                       !(resource.data.get('wageStatus', '') == 'transferred' &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['finalWage', 'wageDetail'])) &&
                       // [RULE-ATT-STATUS] status 화이트리스트 — 임의 문자열 삽입 차단
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                        request.resource.data.get('status', '') in
                          ['scheduled', 'checked_in', 'checked_out', 'absent', 'NO_SHOW'])) ||
                      isSuperAdmin()
                    );

      // 관리자: 소속 사업장 출근 기록 삭제 허용 (TO 삭제 시 고아 데이터 정리)
      // [ATT-H-3] wageConfirmed/wageTransferred 기록 삭제 차단 — rules 레벨에서 강제
      //   코드 레벨 보존 처리만으로는 REST API 직접 호출 우회 가능.
      //   wageTransferred: 급여 지급 완료 — 임금 지급 근거 문서, 삭제 시 근로기준법 위반 소지.
      //   wageConfirmed: 임금 확정 — 법적 확정 이력, 슈퍼어드민만 예외적 삭제 허용.
      // [SEC-11 정리] 이전에 isAdmin() 단독으로 타 사업장 더미 삭제 가능했던 취약점 수정이력 있음.
      // RULE-06: isSubAdminOf 추가 — SubAdmin도 TO 삭제 연쇄 작업에서 attendance 고아 데이터 정리 가능
      allow delete: if isSuperAdmin() ||
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       resource.data.get('wageStatus', '') != 'transferred' &&
                       resource.data.get('wageStatus', '') != 'confirmed');
    }

    // ═══════════════════════════════════════════════════════════
    // monthly_reviews 컬렉션 (실 사용 컬렉션)
    // ═══════════════════════════════════════════════════════════
    match /monthly_reviews/{reviewId} {

      // get: 본인(작성자/수신자), 해당 사업장 관리자/하위관리자, 공개 리뷰
      // resource == null: 문서 미존재 시 존재 여부 확인 허용 (리뷰 작성 여부 체크)
      allow get: if isLoggedIn() && (
        isSuperAdmin() ||
        resource == null ||
        resource.data.reviewerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdminOf(resource.data.businessId) ||
        isSubAdminOf(resource.data.businessId) ||
        resource.data.isPublished == true
      );
      // list: USER는 본인 필터 필수
      //   BUSINESS_ADMIN/SubAdmin: callableGetMonthlyReviewsByBiz CF 경유 — 클라이언트 직접 list 차단
      //     [SEC-MR-LIST 2026-07-14] 관리자 isPublished==true 필터만으로 전체 공개 리뷰 덤프 가능 → 제거
      //     앱 코드 모든 관리자 경로가 CF 전환 완료이므로 규칙 제거해도 기능 영향 없음
      //   USER 경로: 본인 reviewerId 또는 targetUserId 필터
      allow list: if isLoggedIn() && (
        isSuperAdmin()
        // [CF-MIGRATED 2026-07-15] callableGetReviewsForUser CF 이전 완료
        // USER 직접 list 차단 — 타 사용자 리뷰 덤프 방지
      );

      // ADMIN_TO_USER: 해당 사업장 관리자/하위관리자만 작성
      // USER_TO_BUSINESS: 블랙리스트 미포함 일반 유저, 본인 명의(reviewerId == auth.uid)만 허용
      // requestId 필수 — review_requests와 연결되지 않은 가짜 리뷰 차단.
      // [SEC-RR-WORKER-OWN 2026-07-17] USER_TO_BUSINESS: isReviewRequestOwnedBy()로 requestId 소유권 강제
      //   onDocumentCreated에서 auth context 없어 CF 검증 불가 → rules 레벨에서 workerId 교차검증으로 보완.
      // [HIGH-FIX] SubAdmin 누락: 알림에서 리뷰 작성 요청 수락 시 SubAdmin이 리뷰 생성 → PERMISSION_DENIED
      // SEC-76: 생성 시 isPublished를 false로 강제 — 클라이언트가 isPublished:true 직접 설정 차단
      //   onReviewCreated CF가 shouldPublish 평가 후 isPublished를 서버에서 제어
      // SEC-87: rating 범위 강제 (1~5) — 범위 외 rating=100 등으로 사용자/사업장 평균 오염 차단
      //   CF onReviewCreated가 rating > 0인 모든 값을 통계에 포함하므로 규칙 레벨에서 선제 차단
      allow create: if isLoggedIn() &&
                      request.resource.data.get('isPublished', false) == false &&
                      request.resource.data.get('rating', 0) >= 1 &&
                      request.resource.data.get('rating', 0) <= 5 &&
                      (
                        isSuperAdmin() ||
                        (request.resource.data.reviewType == 'ADMIN_TO_USER' &&
                         // SEC-81: reviewerId가 리뷰 작성자 본인임을 강제 — 타 관리자 명의 리뷰 생성 차단
                         request.resource.data.reviewerId == request.auth.uid &&
                         (isAdminOf(request.resource.data.businessId) ||
                          isSubAdminOf(request.resource.data.businessId))) ||
                        (request.resource.data.reviewType == 'USER_TO_BUSINESS' &&
                         isUser() && isNotBlacklisted() &&
                         // [H-01] reviewerId는 익명 보장을 위해 저장하지 않으므로 필드 부재를 강제
                         // (toMap()이 USER_TO_BUSINESS 케이스에서 reviewerId를 생략하는 설계와 일치)
                         !('reviewerId' in request.resource.data) &&
                         'businessId' in request.resource.data &&
                         request.resource.data.businessId.size() > 0 &&
                         'requestId' in request.resource.data &&
                         // [SEC-RR-WORKER-OWN] requestId 소유권 강제 — 타 근무자 리뷰 슬롯 탈취 차단
                         isReviewRequestOwnedBy(request.resource.data.requestId, request.auth.uid, request.resource.data.businessId))
                      );

      // 사업장 답변 추가(USER_TO_BUSINESS): 사업장 관리자/하위관리자는 답변 필드만 수정 가능
      // (평점·태그·코멘트 등 근무자가 작성한 필드는 수정 불가 — 리뷰 조작 방지)
      // [FIX] isSubAdminOf 누락 — SubAdmin이 사업장 대표 답변 작성 시 PERMISSION_DENIED
      // [H-02] 기존 답변 덮어쓰기 차단 — businessResponse가 없을 때만 작성 허용
      // [MEDIUM-FIX 29차] isSuperAdmin update에서 핵심 리뷰 필드 불변 강제
      //   슈퍼어드민이 rating/comment/tags 직접 수정 시 집계 통계(businesses.rating 등)와 불일치 발생
      //   집계 재계산 없이 원본 데이터만 변경하면 플랫폼 신뢰도 훼손
      allow update: if (isSuperAdmin() &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['rating', 'comment', 'tags', 'reviewType',
                                   'reviewerId', 'targetUserId', 'businessId'])) ||
                     // [SEC-92/103] 탈퇴 익명화 — 9-A: 대상자 본인이 자신의 리뷰 식별자 제거
                     // isDeletingAccount 교차검증: deleteAccountWithPassword CF가 마킹한 경우만 허용
                     // (활성 계정이 FieldValue.delete()로 불리한 리뷰 선택 삭제하는 취약점 차단)
                     (isLoggedIn() &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeletingAccount == true &&
                      resource.data.targetUserId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['targetUserName', 'targetUserId', 'comment']) &&
                      request.resource.data.get('targetUserName', '') == '탈퇴한 회원' &&
                      !('targetUserId' in request.resource.data) &&
                      !('comment' in request.resource.data)) ||
                     // [SEC-92/103] 탈퇴 익명화 — 9-B: 작성자 본인이 reviewerId/reviewerName 제거
                     // isDeletingAccount 교차검증: 활성 계정이 리뷰 익명화 후 재리뷰 중복 차단 취약점 차단
                     (isLoggedIn() &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeletingAccount == true &&
                      resource.data.get('reviewerId', '') == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reviewerName', 'reviewerId']) &&
                      request.resource.data.get('reviewerName', '') == '탈퇴한 회원' &&
                      request.resource.data.get('reviewerId', '') == '') ||
                     (isLoggedIn() &&
                      (isAdminOf(resource.data.businessId) ||
                       isSubAdminOf(resource.data.businessId)) &&
                      resource.data.get('businessResponse', null) == null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['businessResponse', 'businessRespondedAt']) &&
                      // [SEC-MR-TS] businessRespondedAt 서버 타임스탬프 강제 — 답변 시각 위조 차단
                      (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['businessRespondedAt']) ||
                       request.resource.data.businessRespondedAt == request.time));

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // badges 컬렉션 (배지 설정 — 슈퍼어드민 전용)
    // ═══════════════════════════════════════════════════════════
    match /badges/{badgeId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // work_types 컬렉션 (업무 유형 — 읽기 전체, 쓰기 슈퍼어드민 전용)
    // [특이사항] 이 컬렉션은 플랫폼 전체 공용 업무 유형 목록이다.
    // BUSINESS_ADMIN이 수정하면 모든 사업장에 영향을 주므로 isSuperAdmin()만 허용.
    // 사업장별 업무 유형은 businesses/{businessId}/workTypes 서브컬렉션을 사용한다.
    // ═══════════════════════════════════════════════════════════
    match /work_types/{workTypeId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // reviews 컬렉션 (레거시 — 신규 사용 없음)
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {

      // get: 작성자·대상자·사업장 관리자
      // [RULE-08] resource==null 처리 추가 — 문서 미존재 시 resource.data 접근으로 항상 PERMISSION_DENIED
      //   발생하던 기능 버그 수정 (monthly_reviews와 동일 패턴 적용)
      allow get: if isLoggedIn() && (
        resource == null ||
        isSuperAdmin() ||
        resource.data.reviewerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdminOf(resource.data.businessId)
      );
      // list: [RULE-FIX-CF 2026-07-13] Deprecated 컬렉션 — 앱 서비스 코드 미사용. 슈퍼어드민만 허용
      allow list: if isSuperAdmin();

      // [E-3 수정 2026-07-14] Deprecated 컬렉션 — 앱 서비스 코드 미사용. create/update 차단
      allow create, update: if false;

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // groups 컬렉션 (Deprecated — 신규 코드에서 미사용)
    // ═══════════════════════════════════════════════════════════
    match /groups/{groupId} {

      // Deprecated 컬렉션이지만 잔존 데이터의 크로스-사업장 노출 차단
      // [크로스-사업장 방지] isAdmin()만으로는 사업장 구분 없이 전체 그룹 조회 가능
      // [M-02] resource == null 가드 추가 — 문서 미존재 시 resource.data 접근 오류 방지
      allow get: if isLoggedIn() && (
        isSuperAdmin() ||
        resource == null ||
        isAdminOf(resource.data.businessId) ||
        isSubAdminOf(resource.data.businessId)
      );
      // [RULE-FIX-CF 2026-07-13] Deprecated 컬렉션 — 앱 코드 미사용. 슈퍼어드민만 허용
      allow list: if isSuperAdmin();

      // [LOW-4 수정 2026-07-16] Deprecated 컬렉션 — reviews 컬렉션과 동일하게 쓰기 전면 차단
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // schedule_change_requests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /schedule_change_requests/{requestId} {

      // get: 지원자 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민 (resource==null: 문서 미존재 시 허용)
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.applicantUid) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [CRIT-02] USER는 반드시 applicantUid == auth.uid 필터 필수
      // [크로스-사업장 방지] isAdminOf(businessId)로 타 사업장 스케줄 변경 요청 덤프 차단
      // [BUGFIX] TO 삭제 시 applicationId whereIn 쿼리 지원 — businessId 필터 없이도
      //   관리자 본인의 user 문서 businessId로 검증하는 폴백 추가
      // [CF-MIGRATED 2026-07-15] getMyScheduleChangeRequests → callableGetMyScheduleChanges CF 이전 완료
      //   USER 직접 list 잔존 이유: _cleanupApplicationRelatedData 사용자 취소 경로
      //   (applicationId+applicantUid+status 쿼리 — filters 검증 불가로 isUser()+limit 폴백 유지)
      // [2026-07-13] 직접 쿼리 잔존분 전수 businessId isEqualTo 필터 포함 확인 완료:
      //   · getPendingScheduleChangeRequestCount: businessId+status
      //   · _cleanupApplicationRelatedData 관리자 경로: applicationId+businessId
      //   관리자 경로: isAdminOf/isSubAdminOf로 요청자 본인 사업장인지 검증 (타 사업장 덤프 차단)
      //   USER 경로: 본인 applicantUid 필터 유지
      // [SEC-SCR-LIST 2026-07-17] 앱 코드 CF 이전 완료(2026-07-15) → REST API 직접 덤프 차단
      //   모든 list 쿼리: callableGetScheduleChangeRequests / callableGetMyScheduleChanges
      //                  / callableGetScheduleChangeRequestsForDate CF 경유
      allow list: if isSuperAdmin();

      // 생성: 지원자 본인 또는 해당 사업장 관리자/하위관리자(추가근무/미출근 요청)
      // SEC-72: USER 경로 businessId 소속 검증 추가 — 타 사업장 ID로 노이즈 문서 삽입 차단
      //   payment_change_requests·interim_settlement_requests와 동일한 패턴 적용
      // SEC-80: USER 경로 status=='PENDING' 강제 + requestedByUid==auth.uid 검증
      //   — 클라이언트가 status='APPROVED'로 직접 생성하거나 requestedByUid를 위조하는 것을 차단
      // [SCR-BL] isNotBlacklisted() 와 businessId 소속 검증을 단일 get() 호출로 통합
      //   — 동일 경로 2회 get() 시 Firebase 에뮬레이터 evaluation error 방지
      // [SCR-01 보류] 관리자 경로 applicantUid 소속 검증 — isAdminOf+get() 조합이
      //   에뮬레이터에서 evaluation error 유발, LOW 영향(PENDING 레코드 1건 노출)으로 보류
      // [B6-FIX] USER 경로 requestedAt 서버 타임스탬프 강제 — 감사 기록 소급·미래 조작 차단
      //   클라이언트(createScheduleChangeRequest)에서 FieldValue.serverTimestamp() 사용으로 연동됨
      allow create: if isLoggedIn() && (
                      (request.resource.data.applicantUid == request.auth.uid &&
                       isValidSCRCreator(request.resource.data.businessId) &&
                       request.resource.data.status == 'PENDING' &&
                       request.resource.data.requestedByUid == request.auth.uid &&
                       (!('requestedAt' in request.resource.data) ||
                        request.resource.data.requestedAt == request.time)) ||
                      // [RULE-FIX-M3] 관리자 create 경로 status/requestedByUid 제한 추가
                      //   기존: 관리자면 status:'APPROVED' 직접 생성, requestedByUid 위조 등 제한 없음
                      //   수정: PENDING 강제 + requestedByUid 본인 검증
                      // [TS-FIX 2026-07-16] requestedAt 서버타임스탬프 강제 — 관리자 경로 소급 방지
                      ((isAdminOf(request.resource.data.businessId) ||
                        isSubAdminOf(request.resource.data.businessId) ||
                        isSuperAdmin()) &&
                       request.resource.data.status == 'PENDING' &&
                       request.resource.data.requestedByUid == request.auth.uid &&
                       (!('requestedAt' in request.resource.data) ||
                        request.resource.data.requestedAt == request.time))
                    );

      // [CF-ONLY] 모든 상태 업데이트는 CF Admin SDK 전용 — 직접 클라이언트 쓰기 차단
      //   - 승인/거절: callableApproveScheduleChangeRequest
      //   - 취소: callableCancelScheduleChangeRequest (APPROVED 취소 시 applications 날짜 역산 필수)
      // [SCR-S1-FIX] APPROVED→CANCELED 직접 write 브랜치 삭제
      //   — 클라이언트 직접 CANCELED 전환 시 applications.leaveDates/extraWorkDates 역산 로직 미실행
      //   — CF 이전 완료(2026-07-14)로 이 브랜치는 완전 데드코드. CF Admin SDK는 rules 우회.
      allow update: if false;

      // 관리자/하위관리자: 소속 사업장 스케줄 변경 요청 삭제 허용 (TO 삭제 시 고아 데이터 정리)
      // [FIX] isSubAdminOf 누락 — SubAdmin이 TO 연계 정리 시 고아 데이터 발생
      // [M-8 수정 2026-07-17] PENDING 상태 클라이언트 삭제 차단
      //   관리자가 불리한 요청을 거절 기록 없이 삭제하는 남용 방지.
      //   TO 삭제 cascade는 CF Admin SDK 경유 → rules 우회하므로 영향 없음.
      allow delete: if isSuperAdmin() ||
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       resource.data.get('status', '') != 'PENDING');
    }

    // ═══════════════════════════════════════════════════════════
    // idCardAccessRequests 컬렉션
    // ═══════════════════════════════════════════════════════════
    // idCardAccessRequests 컬렉션 (신분증 열람 요청)
    //
    // 데이터 구조:
    //   requesterId          — 요청한 관리자 uid
    //   requesterBusinessId  — 요청한 관리자의 사업장 id
    //   targetUserId         — 신분증 제공 대상 근무자 uid
    //   applicationId        — 연관 지원서 id
    //   status               — pending | approved | rejected | canceled | expired
    //   expiresAt            — 승인 후 만료 시각 (서버에서 기록)
    //
    // 설계 원칙:
    //   · BUSINESS_ADMIN/SubAdmin은 반드시 소속 필터(requesterId 또는 requesterBusinessId) 필수
    //     → 타 사업장 신분증 열람 요청 목록 덤프 방지
    //   · create 시 requesterBusinessId가 본인 소속 사업장인지 isAdminOf로 검증
    //     → 타 사업장 명의로 요청 생성 차단
    //   · update는 targetUserId(근무자 본인)만 상태 변경 가능 (승인/거절)
    //     → 관리자가 수신자 대신 승인/거절하는 것 차단
    // ═══════════════════════════════════════════════════════════
    match /idCardAccessRequests/{requestId} {

      // get: 요청자(requesterId)·수신자(targetUserId)·슈퍼어드민만 단건 조회 가능
      // resource==null: 문서 미존재 시 createIdCardAccessRequest 중복 체크 허용
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.requesterId) ||
                   isOwner(resource.data.targetUserId) ||
                   isSuperAdmin()
                 );

      // list: [크로스-사업장 방지] 관리자도 반드시 소속 필터 필수
      //
      // 허용 패턴 (앱 코드 쿼리와 1:1 매핑):
      //   A) requesterId == auth.uid
      //      → getMyIdCardRequests (내가 보낸 요청 목록)
      //      → createIdCardAccessRequest 중복 체크 (requesterId + targetUserId + status)
      //      → checkIdCardAccess 최신 조회 (requesterId + targetUserId)
      //
      //   B) isAdminOf(requesterBusinessId) / isSubAdminOf(requesterBusinessId)
      //      → _cleanupApplicationRelatedData 관리자 취소 경로
      //        (applicationId + requesterBusinessId + status 쿼리)
      //      → 같은 사업장 내 다른 관리자가 보낸 요청도 포함 (의도된 동작:
      //         관리자 변경 시에도 소속 사업장의 모든 요청 정리 가능)
      //
      //   C) targetUserId == auth.uid
      //      → getPendingIdCardRequestsForUser (내게 온 요청 목록)
      //      → _cleanupApplicationRelatedData 사용자 취소 경로
      //        (applicationId + targetUserId + status 쿼리)
      // [CF-MIGRATED 2026-07-15] 모든 list 경로 CF 이전 완료 → isSuperAdmin only
      //   · USER: callableGetMyIdCardRequests(USER 수신), callableDeleteAccountPreData(탈퇴)
      //   · ADMIN: callableCheckIdCardAccess, callableGetMyIdCardRequestsAsAdmin,
      //            callableCreateIdCardAccessRequest(중복체크), callableCleanupApplicationData
      allow list: if isLoggedIn() && isSuperAdmin();

      // create: BUSINESS_ADMIN / SubAdmin / 슈퍼어드민이 발신 가능 (H-7)
      //   · requesterId == auth.uid : 본인 명의로만 생성 (타인 명의 위조 차단)
      //   · isAdminOf/isSubAdminOf(requesterBusinessId) : 소속 사업장 명의로만 생성
      //     → 타 사업장 명의로 요청 생성해 불법 신분증 열람 시도 차단
      //   · isSuperAdmin() : 감사/운영 목적 신분증 열람 요청 허용
      // [SEC-81] CREATE 시 status='pending' 강제 + expiresAt 생성 금지
      //   — 관리자가 status='approved'+expiresAt을 직접 설정해 근무자 동의 없이 신분증 열람하는
      //     취약점 차단. expiresAt은 근무자가 update(approved) 처리 시에만 기록 가능.
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      ((isBusinessAdmin() || isSubAdmin()) &&
                       request.resource.data.requesterId == request.auth.uid &&
                       (isAdminOf(request.resource.data.requesterBusinessId) ||
                        isSubAdminOf(request.resource.data.requesterBusinessId)) &&
                       request.resource.data.get('status', '') == 'pending' &&
                       !('expiresAt' in request.resource.data) &&
                       // [RULE-IDCARD-TIMESTAMP] 신분증 열람 요청 날짜 소급 차단
                       (!('createdAt' in request.resource.data) ||
                        request.resource.data.createdAt == request.time))
                    );

      // update: 수신자(targetUserId = 근무자 본인)만 상태 변경 가능
      //   · 변경 가능 필드: status, respondedAt, rejectionReason, expiresAt
      //   · status = approved 시 expiresAt은 앱 코드에서 +7일로 기록
      //   · 관리자가 직접 승인/거절 불가 — 근무자 동의 기반 설계
      // [MEDIUM-FIX] 관리자 취소 경로 누락: _cleanupApplicationRelatedData에서 지원 취소 시
      //              status='canceled' 업데이트 → PERMISSION_DENIED. 발신자 사업장 관리자/SubAdmin의
      //              status only 업데이트 허용 추가 (근무자 승인/거절과 구별)
      allow update: if isLoggedIn() && (
                      (isOwner(resource.data.targetUserId) &&
                       // SEC-27: pending → approved/rejected 전이만 허용
                       // (approved → rejected 역변조, rejected → approved 자기 승인 차단)
                       resource.data.status == 'pending' &&
                       (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected') &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'respondedAt', 'rejectionReason', 'expiresAt']) &&
                       // [H-1] expiresAt 서버 시각 + 7일 이내로 제한 — 임의 무기한 연장 차단
                       // [ID-2] 클라이언트 시계 오차(clock skew) 5분 허용 — DateTime.now() 기반 expiresAt 설정 시 PERMISSION_DENIED 방지
                       // [RULE-FIX-L1] expiresAt 최솟값 추가 — 과거 시각으로 설정해 즉시 만료 조작 차단
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiresAt']) ||
                        (request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm') &&
                         request.resource.data.expiresAt >= request.time - duration.value(5, 'm')))) ||
                      ((isAdminOf(resource.data.requesterBusinessId) ||
                        isSubAdminOf(resource.data.requesterBusinessId)) &&
                       // [LOW-FIX 29차] 현재 status 전제 조건 추가 — approved 상태 재조작 차단
                       //   이미 처리 완료된 요청을 expired로 위장해 신분증 접근 기록 은폐 방지
                       resource.data.status in ['pending', 'approved'] &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status']) &&
                       // SEC-33: 관리자 취소/만료만 허용 — 스스로 approved 전환 차단
                       (request.resource.data.status == 'canceled' ||
                        request.resource.data.status == 'expired')) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // review_requests 컬렉션
    // ═══════════════════════════════════════════════════════════
    match /review_requests/{requestId} {

      // get: 해당 워커 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민 (resource==null: 문서 미존재 시 허용)
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.workerId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: USER는 본인 workerId 필터 필수
      // [RULE-FIX-H2 2026-07-13 회귀 수정] 관리자 LIST 제거 — CF callableGetReviewRequestsByBiz 전용
      // 관리자가 직접 LIST를 하면 크로스-사업장 덤프 가능 → if false로 차단
      allow list: if isLoggedIn() && (
                    isSuperAdmin()
                    // [CF-MIGRATED 2026-07-15] callableGetMyReviewRequests CF 이전 완료
                    // USER 직접 list 차단 — 크로스-사용자 리뷰 요청 덤프 방지
                  );

      // 생성: 해당 사업장 관리자/하위관리자 또는 슈퍼어드민
      // [SEC-RR-STATUS] status 초기값 'PENDING' 강제 — 관리자가 COMPLETED 등으로 직접 생성해
      //   CF onReviewCreated 처리 없이 완료된 요청으로 오인되는 취약점 차단
      // [SEC-RR-CREATE-MEMBER] workerId가 해당 사업장 소속 근무자인지 검증
      //   악의적 관리자가 타 사업장 근무자를 workerId로 지정해 허위 리뷰 TO-DO 생성 차단
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      ((isAdminOf(request.resource.data.businessId) ||
                        isSubAdminOf(request.resource.data.businessId)) &&
                       request.resource.data.get('status', '') == 'PENDING' &&
                       exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/members/$(request.resource.data.get('workerId', '_'))))
                    );

      // 수정: 워커(자신의 리뷰 제출 필드만) · 해당 사업장 관리자/하위관리자(자신의 필드만) · 슈퍼어드민
      allow update: if isLoggedIn() && (
                      // 워커: 자신의 리뷰 제출 필드만 (isPublished 등 변조 불가)
                      // [MEDIUM-FIX 29차] workerStatus 값 화이트리스트 — 임의 값 삽입으로 CF 트리거 분기 오작동 차단
                      (isOwner(resource.data.workerId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['workerStatus', 'workerReviewId']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workerStatus']) ||
                        request.resource.data.workerStatus in ['pending', 'submitted'])) ||
                      // [SEC-88] 탈퇴 익명화: 계정 삭제 flow에서 workerName만 '탈퇴한 회원'으로 변경 허용
                      // auth_service.dart step 3(users 삭제) 이전에 실행되므로 isUser() 체크 통과
                      // [RULE-FIX-L1] workerName 값 제한 추가 — 활성 계정도 임의 문자열 변경 가능했던 취약점 차단
                      // [MEDIUM-FIX 29차] isDeletingAccount 교차검증 추가 — monthly_reviews 동일 패턴과 일관성
                      (isOwner(resource.data.workerId) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeletingAccount == true &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['workerName']) &&
                       request.resource.data.get('workerName', '') == '탈퇴한 회원') ||
                      // 관리자/하위관리자: 자신의 리뷰 제출 필드만
                      // [MEDIUM-FIX 29차] adminStatus 값 화이트리스트 추가
                      ((isAdminOf(resource.data.businessId) ||
                        isSubAdminOf(resource.data.businessId)) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['adminStatus', 'adminReviewId']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminStatus']) ||
                        request.resource.data.adminStatus in ['pending', 'submitted'])) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // settings 컬렉션 (앱 공통 설정 — review_tags, trust_rules 등)
    // ═══════════════════════════════════════════════════════════
    match /settings/{settingId} {

      // 읽기: 로그인된 사용자 전체 (최저임금·보험요율 등 공개 설정)
      allow read: if isLoggedIn();

      // 쓰기: 슈퍼어드민만 + [MEDIUM-5 수정 2026-07-15] trust_rules 값 범위 검증
      // maxScore 0~100, decreaseRules 내 개별 포인트 -100~0 제한 (계정 침해 시 극단값 조작 차단)
      allow write: if isSuperAdmin() && (
        settingId != 'trust_rules' ||
        (
          (!request.resource.data.keys().hasAll(['maxScore']) || (
            request.resource.data.maxScore is int &&
            request.resource.data.maxScore >= 0 &&
            request.resource.data.maxScore <= 100
          ))
        )
      );
    }

    // ═══════════════════════════════════════════════════════════
    // worker_locations 컬렉션 (근로자 실시간 위치)
    // ═══════════════════════════════════════════════════════════
    match /worker_locations/{applicationId} {

      // get: 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.userId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: 슈퍼어드민만 허용
      //   · 위치정보는 개인정보보호법 상 민감 정보 — 관리자 조회는 CF 경유 강제
      //   · BUSINESS_ADMIN/SUB_ADMIN: callableGetLocationsForApplications CF Admin SDK 경유
      //   · USER 탈퇴 처리(SEC-94): callableDeleteWorkerLocations CF Admin SDK 경유
      //     [CF-MIGRATED 2026-07-15] USER 직접 list 완전 차단
      allow list: if isLoggedIn() && isSuperAdmin();

      // 생성·수정: 본인(userId == auth.uid) 또는 슈퍼어드민
      // SEC-34: businessId 소속 검증 추가 — 타 사업장에 위치 데이터 삽입 차단
      // SEC-82: applicationId 소유권 검증 — 타인의 applicationId로 경로 선점(DoS) 차단
      //   get()으로 applications/{applicationId}.uid == auth.uid 확인
      allow create: if isLoggedIn() && (
                      (request.resource.data.userId == request.auth.uid &&
                       request.resource.data.businessId ==
                         get(/databases/$(database)/documents/users/$(request.auth.uid))
                           .data.get('businessId', '_NONE_') &&
                       get(/databases/$(database)/documents/applications/$(applicationId))
                         .data.get('uid', '_NONE_') == request.auth.uid) ||
                      isSuperAdmin()
                    );

      // [M-1] 식별자 필드 불변 조건 추가 — userId/businessId/applicationId 변조 차단
      // create 규칙이 userId == auth.uid를 강제하지만 update에서 변경을 허용하면
      // 타인 userId로 교체하여 get 규칙의 isOwner 체크를 우회할 수 있음
      allow update: if isLoggedIn() && (
                      (isOwner(resource.data.userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['userId', 'businessId', 'applicationId'])) ||
                      isSuperAdmin()
                    );

      // 삭제: 슈퍼어드민 또는 본인
      allow delete: if isSuperAdmin() ||
                     (isLoggedIn() && isOwner(resource.data.userId));
    }

    // ═══════════════════════════════════════════════════════════
    // trust_score_history 컬렉션 (신뢰도 변동 이력)
    // ═══════════════════════════════════════════════════════════
    match /trust_score_history/{historyId} {
      // get: 단건 조회 — resource가 존재할 때만 userId 접근 가능
      allow get: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (resource != null && isOwner(resource.data.userId))
                 );
      // list: USER는 본인 userId 필터 필수, 관리자는 소속 사업장 businessId 필터 필수
      // [크로스-사업장 방지] 타 사업장 근무자 신뢰도 이력 덤프 차단
      //   · USER: userId == auth.uid 필터 (본인 신뢰도 변동 이력 조회)
      //     - getScoreHistory(userId) — businessId 없이 호출 (USER 컨텍스트)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getScoreHistory(userId, businessId: businessId) — 관리자 컨텍스트
      //   · SubAdmin: isSubAdminOf(businessId) 필터 (동일 패턴)
      // [RULE-FIX-CF 2026-07-13] 호출 코드 없음(getScoreHistory B03 미완성) → isSuperAdmin() 제한
      allow list: if isSuperAdmin();
      // [SEC-03 완료] 생성: CF Admin SDK 전용 — 클라이언트 직접 create 차단
      // callableReportLate·onAttendanceWageStatusChanged CF 트리거에서 Admin SDK로 기록
      // 슈퍼어드민 긴급 수정만 허용
      // [L-5 수정 2026-07-17] CF Admin SDK 전용 — 클라이언트 직접 write 차단
      //   슈퍼어드민도 callerUid/reason 임의 설정 가능하므로 차단. CF Admin SDK는 rules 우회.
      allow create: if false;
      // [LOW-FIX] 감사 로그 불변 — update 차단 (Admin SDK는 rules 우회하여 긴급 수정 가능)
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // restart_program_history 컬렉션 (재시작 프로그램 신청 이력)
    // ═══════════════════════════════════════════════════════════
    match /restart_program_history/{historyId} {
      allow get: if isLoggedIn() && (
                   isSuperAdmin() ||
                   (resource != null && isOwner(resource.data.userId))
                 );
      // list: [MEDIUM-FIX] CF 전용 컬렉션 — 앱 클라이언트에서 이 컬렉션을 list하는 코드가 없음
      // isUser() 허용 시 재시작 프로그램 신청자 전원 이력(userId·신청 날짜·벌점 사유)이 노출됨
      // → isSuperAdmin()만 허용 (클라이언트에서 사용 시 CF 프록시 구현 필요)
      allow list: if isSuperAdmin();
      // 생성: Cloud Function(applyRestartProgram) Admin SDK만 허용 (클라이언트 직접 쓰기 차단)
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // employment_contracts 컬렉션 (근로계약서)
    // ═══════════════════════════════════════════════════════════
    match /employment_contracts/{contractId} {

      // get: 근무자 본인 · 해당 사업장 관리자 · 하위관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isOwner(resource.data.workerId) ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: [CF 이전 완료 2026-07-17] 클라이언트 직접 list 쿼리 전면 차단
      //   · USER: callableGetMyContracts CF (2026-07-15)
      //   · 관리자(businessId): callableGetContractsByBiz CF
      //   · 계약서 무효화(contractQ1/Q2): callableVoidApplicationContracts CF (H-CF-2, 2026-07-16)
      //   updateApplicationStatus() CONTRACT_PENDING→PENDING 롤백 시 계약서 조회도 CF 경유 완료.
      //   클라이언트 코드 전수 점검 — employment_contracts WHERE 쿼리 0건 확인 (2026-07-17).
      //   CF Admin SDK는 rules 우회 → CF 호출 경로에 영향 없음.
      allow list: if false;

      // 생성: 해당 사업장 관리자/하위관리자 또는 슈퍼어드민 (확정 시 자동 생성)
      // [HIGH-FIX] SubAdmin 누락: work_applicants_dialog에서 _batchApprove 실행 시
      //            findOrCreateContract() → employment_contracts CREATE → PERMISSION_DENIED
      //            → SubAdmin의 지원자 일괄 승인 기능 전체 불가 → isSubAdminOf 추가
      // SEC-38: workerId 위조 차단 — applicationId의 실제 지원자(uid)와 workerId 일치 검증
      // [CON-03-CREATE] employerSignedAt CREATE 시 서버타임스탬프 강제
      //   UPDATE 규칙(CON-03)과 동일 보호. isNewUnsaved 경로(tx.set)에서 과거 날짜 위변조 차단.
      //   근로계약서 서명일 위변조는 노동법 위반 소지.
      allow create: if isLoggedIn() && (
                      isSuperAdmin() ||
                      ((isAdminOf(request.resource.data.businessId) ||
                        isSubAdminOf(request.resource.data.businessId)) &&
                       'applicationId' in request.resource.data &&
                       exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)) &&
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
                         .data.get('uid', '_NONE_') == request.resource.data.workerId &&
                       // [BUG-1] applicationId 소속 사업장 교차검증 — A사업장 관리자가 B사업장 지원서로
                       //   A사업장 명의 계약서 생성하는 크로스-사업장 계약 위조 차단
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
                         .data.get('businessId', '_NONE_') == request.resource.data.businessId &&
                       // [MEDIUM-2 수정 2026-07-15] 계약 create 시 근무자 서명 필드 사전 삽입 차단
                       //   callableFinalizeWorkerSignature CF(Admin SDK) 전용 — 서명 없이 서명 완료 위조 차단
                       // [SEC-EMPLOYER-SIG 2026-07-15] employer 서명 필드도 차단 —
                       //   callableFinalizeEmployerSignature CF(Admin SDK) 전용 (storage.rules if false 병행)
                       !request.resource.data.keys().hasAny([
                         'workerSignatureUrl', 'workerSignatureHash', 'workerSignedAt',
                         'employerSignatureUrl', 'employerSignatureHash', 'employerSignedAt'
                       ]) &&
                       // [MEDIUM-CONTRACT-STATUS] status 화이트리스트 — 'completed' 위조 계약서 차단
                       //   CF Admin SDK는 rules 우회하므로 정상 생성 흐름에 영향 없음
                       request.resource.data.get('status', 'pending_employer') == 'pending_employer' &&
                       // [RULE-CONTRACT-TIMESTAMP] 계약 초안 날짜 소급 차단 — 계약 제시 시점 위변조 방지
                       (!('createdAt' in request.resource.data) ||
                        request.resource.data.createdAt == request.time)))
                    );

      // 슈퍼어드민: 오기재 정정 등 운영 목적 수정 허용
      // [RULE-FIX-M5] 서명 증거 필드 불변 강제 — 근로기준법상 계약서 위변조 방지
      //   서명 URL/해시/타임스탬프는 CF callableFinalizeWorkerSignature 전용
      // [HIGH-FIX 29차] completed 계약서 핵심 필드 보호 — 관리자 브랜치(L1541)와 동일 조건 추가
      //   isSuperAdmin() completed 업데이트 허용 시 articles/wage/slots 등 계약 내용 변조 가능
      allow update: if isSuperAdmin() &&
                      resource.data.status != 'completed' &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'workerSignatureUrl', 'workerSignatureHash', 'workerSignedAt',
                        'employerSignatureUrl', 'employerSignatureHash', 'employerSignedAt'
                      ]);

      // 근무자: 계약해지 수락 시 계약서 voided 전환 허용
      // terminationStatus == PENDING인 경우에만 허용 (일방 무효화 차단)
      // requestTermination()이 APPLICATION과 CONTRACT 양쪽에 terminationStatus='PENDING' 기록
      // [B4-FIX] contractVoidedAt 서버 타임스탬프 강제 — 계약 무효화 날짜를 과거/미래로 조작 차단
      //   employerSignedAt에 동일 패턴이 적용된 것과 일관성 유지
      allow update: if isLoggedIn() &&
                      isOwner(resource.data.workerId) &&
                      resource.data.get('terminationStatus', '') == 'PENDING' &&
                      resource.data.status != 'completed' &&
                      resource.data.status != 'voided' &&
                      request.resource.data.get('status', '') == 'voided' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'contractVoidedAt', 'voidReason']) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contractVoidedAt']) ||
                       request.resource.data.contractVoidedAt == request.time);

      // 수정: 역할별 수정 가능 필드 제한 (completed·voided 상태는 관리자/근무자 차단)
      allow update: if isLoggedIn() &&
                      resource.data.status != 'completed' &&
                      resource.data.status != 'voided' && (
                        // [CF-ONLY] 근무자 서명 완료 (pending_worker → completed)
                        //   — callableFinalizeWorkerSignature(Admin SDK) 전용.
                        //   클라이언트 직접 write 제거: 서명 우회 차단 + applications 원자 처리.
                        // 관리자/하위관리자: 사업주 서명 + 계약 관리 필드만
                        // [H-003] articles/templateId는 근무자 서명 전에만 수정 가능
                        // [HIGH-FIX] SubAdmin 누락: day_applicants_dialog 계약서 서명·수정 시
                        //            PERMISSION_DENIED 발생 → isSubAdminOf 추가
                        // [S-H1-FIX] slots 필드도 근무자 서명 후 변경 불가로 보호
                        //            articles/templateId와 동일 조건 적용 — 계약 위변조 방지
                        ((isAdminOf(resource.data.businessId) ||
                          isSubAdminOf(resource.data.businessId)) &&
                         // [H7-FIX] terminationStatus 제거 — 관리자 직접 조작으로 계약 임의 무효화 차단.
                         //   공격: REST API로 terminationStatus='PENDING' 설정 → 근무자 UI에서 계약서 voided 전환.
                         //   terminationStatus 설정은 CF Admin SDK 전용(callableRequestTermination).
                         // [SEC-EMPLOYER-SIG 2026-07-15] employerSignatureUrl/Hash/At 제거 —
                         //   callableFinalizeEmployerSignature CF(Admin SDK) 전용 경로.
                         //   클라이언트 직접 write 차단으로 타 계약서 서명 URL 복사 공격 차단.
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'updatedAt',
                           'articles', 'templateId', 'slots', 'applicationIds',
                           'contractVoidedAt', 'voidReason',
                           // [M3-FIX] 파트변경 시 계약서 workType/wage/wageType 동기화 허용
                           'workType', 'wage', 'wageType',
                           // [CONTRACT-L1-FIX] voidedBy — 감사 기록 허용, 본인 UID 강제 조건 아래 추가
                           'voidedBy'
                         ]) &&
                         // [CONTRACT-L1-FIX] voidedBy 본인 UID 강제 — 타 관리자 명의 무효화 위조 차단
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['voidedBy']) ||
                          request.resource.data.voidedBy == request.auth.uid) &&
                         // [CONTRACT-M1-FIX] completed 직접 전이 차단 — callableFinalizeWorkerSignature CF 전용
                         //   관리자가 pending_* → completed 직접 write 시 workerSignatureUrl 누락 + applications 미처리
                         // [M12-FIX] pending_worker → pending_employer 역전환 차단 — 근무자 서명 우회 방지
                         //   callableFinalizeEmployerSignature CF가 pending_employer→pending_worker 전이를 서버에서 수행
                         //   관리자가 직접 pending_worker→pending_employer 쓰면 근무자에게 서명 완료로 오인
                         // [M-4 FIX] pending_worker → voided 직접 전환 차단 — callableVoidApplicationContracts CF 전용
                         //   관리자가 직접 voided 전환 시 applications 상태 미처리 + 근무자 알림 누락
                         //   CF Admin SDK는 rules 우회 → CF 경유 정상 처리에 영향 없음
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                          (request.resource.data.get('status', '') != 'completed' &&
                           !(resource.data.get('status', '') == 'pending_worker' &&
                             request.resource.data.get('status', '') == 'pending_employer') &&
                           !(resource.data.get('status', '') == 'pending_worker' &&
                             request.resource.data.get('status', '') == 'voided'))) &&
                         // [CONTRACT-L2-FIX] contractVoidedAt 서버 타임스탬프 강제 (관리자 경로)
                         //   근무자 경로(1492줄)와 동일 보호 — 과거/미래 무효화 날짜 위변조 차단
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contractVoidedAt']) ||
                          request.resource.data.contractVoidedAt == request.time) &&
                         // [SEC-104] applicationIds도 pending_employer 상태에서만 수정 허용
                         //   근무자 서명 후 계약서에 다른 지원서로 재귀속하는 공격 차단
                         // [SEC-WAGE-LOCK] workType/wage/wageType도 pending_employer 상태에서만 수정 허용
                         //   공격: pending_worker(근무자 서명 대기) 중 관리자가 임금 임의 인하 → 낮은 임금으로 서명
                         //   CF(callableChangeApplicationWorkType)는 Admin SDK 사용 → rules 우회(정상 경로)
                         (!request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['articles', 'templateId', 'slots', 'applicationIds',
                                     'workType', 'wage', 'wageType']) ||
                          resource.data.status == 'pending_employer'))
                      );

      // [특이사항] voidContract() 실행 흐름: 계약서를 voided 전환 후 application 취소 루프 실행.
      // 일부 application 취소 실패 시 failedIds를 voidFailedAppIds에 기록해 재처리(retryVoidFailedApps)에 사용.
      // 이 시점엔 이미 status='voided'이므로 위 update 규칙(status != voided 조건)에서 막힘 → 별도 규칙 필요.
      allow update: if isLoggedIn() &&
                      (isAdminOf(resource.data.businessId) || isSubAdminOf(resource.data.businessId)) &&
                      resource.data.status == 'voided' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['voidFailedAppIds']);

      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // member_invitations 컬렉션 (하위 관리자 초대)
    // ═══════════════════════════════════════════════════════════
    match /member_invitations/{invitationId} {

      // get: 수신자 · 발신자 · 해당 사업장 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                   resource == null ||
                   request.auth.uid == resource.data.targetUid ||
                   request.auth.uid == resource.data.invitedBy ||
                   isAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );

      // list: USER는 본인 targetUid 필터 필수
      // [RULE-FIX-H3 2026-07-13 회귀 수정] 관리자 LIST 제거 — 단건 get으로만 접근
      // 관리자 클라이언트 코드는 모두 _invitations.doc(id).get() 단건 조회 사용
      // 크로스-사업장 덤프 가능성 → 관리자 LIST 전면 차단
      allow list: if isLoggedIn() && (
                   isSuperAdmin()
                   // [CF-MIGRATED 2026-07-15] callableGetMyInvitations CF 이전 완료
                   // USER 직접 list 차단 — 전화번호 노출 방지
                 );

      // 생성: 해당 사업장 관리자/하위관리자만 (초대 발송)
      // SEC-31: invitedBy 위조 차단 — 본인 명의로만 초대 생성 가능
      //   invitedBy 위조 시 get 조건의 invitedBy==auth.uid를 통해 타 사업장 초대 내용 열람 가능
      // [M8-FIX] isSubAdminOf 추가 — SubAdmin 초대 발송 PERMISSION_DENIED 버그 수정.
      //   SubAdmin은 isAdminOf를 통과하지 못해 member_management_screen에서 초대 발송 실패.
      // [M10-FIX] status 초기값 'pending' 강제 — status='accepted' 초대 직접 생성 차단.
      //   applications, schedule_change_requests 등과 동일 패턴 적용.
      allow create: if isLoggedIn() && (
                      ((isAdminOf(request.resource.data.businessId) ||
                        isSubAdminOf(request.resource.data.businessId)) &&
                       request.resource.data.invitedBy == request.auth.uid &&
                       request.resource.data.get('status', '') == 'pending' &&
                       // [LOW-FIX 2026-07-14] createdAt 서버 타임스탬프 강제 — 미래 날짜 주입으로 30일 유효기간 우회 차단
                       request.resource.data.createdAt == request.time) ||
                      isSuperAdmin()
                    );

      // 수정: 초대받은 사람(수락/거절) · 해당 사업장 관리자(취소) · 슈퍼어드민
      // [SEC-001] 수신자는 status/respondedAt 필드만 변경 가능 (businessId 조작 차단)
      // [SEC-FIX] 상태 전이 검증: pending 상태에서만 수락/거절 가능
      //   → accepted 상태에서 rejected로 재변경하는 것을 차단
      // SEC-42: 관리자 브랜치에 필드 제한 추가 — targetUid·businessId·invitedBy 위조 차단
      allow update: if isLoggedIn() && (
                      (request.auth.uid == resource.data.targetUid &&
                       resource.data.status == 'pending' &&
                       // [MEDIUM-3 수정 2026-07-15] 수신자 status 화이트리스트 누락 — 임의 값으로 초대 무효화 차단
                       request.resource.data.status in ['accepted', 'rejected'] &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'respondedAt'])) ||
                      // [LOW-FIX 2026-07-14] isSubAdminOf 추가 — SubAdmin이 본인 발송 초대를 취소할 경로 없었음 (delete만 가능)
                      ((isAdminOf(resource.data.businessId) || isSubAdminOf(resource.data.businessId)) &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'cancelled' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'canceledAt'])) ||
                      isSuperAdmin()
                    );

      // SEC-44: 관리자·발신자 삭제 허용 추가 (슈퍼어드민 단독 제한 완화)
      // [RULE-FIX-L4] isSubAdminOf 추가 — SubAdmin이 소속 사업장 초대를 일괄 삭제 가능하도록
      allow delete: if isSuperAdmin() ||
                       isAdminOf(resource.data.businessId) ||
                       isSubAdminOf(resource.data.businessId) ||
                       (isLoggedIn() && request.auth.uid == resource.data.invitedBy);
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/{businessId}/members 서브컬렉션 (하위 관리자 목록)
    // ═══════════════════════════════════════════════════════════
    match /businesses/{businessId}/members/{uid} {

      // 단일 문서 읽기: 해당 사업장 관리자 · 멤버 본인 · 하위 관리자 · 슈퍼어드민
      allow get: if isLoggedIn() && (
                    isAdminOf(businessId) ||
                    request.auth.uid == uid ||
                    isSubAdminOf(businessId) ||
                    isSuperAdmin()
                  );

      // 목록 조회(getMembers): 해당 사업장 관리자 · 하위 관리자 · 슈퍼어드민
      // list 시 uid 와일드카드가 unbound이므로 request.auth.uid == uid 사용 불가
      allow list: if isLoggedIn() && (
                    isAdminOf(businessId) ||
                    isSubAdminOf(businessId) ||
                    isSuperAdmin()
                  );

      // 생성: 해당 사업장 관리자 · 유효한 pending 초대 수락 시 본인(uid 일치) · 슈퍼어드민
      // [MEDIUM-FIX] request.auth.uid == uid 단독 허용으로 어느 사업장에나 자기 등록 가능했던 취약점 수정
      // [MEDIUM-01] isValidPendingInvitation — pending 상태 + 대상 일치 + 30일 이내 통합 검증
      //   초대 수락 경로: members 문서에 invitationId 포함 필수 → get() 1회로 전체 검증
      allow create: if isLoggedIn() && (
                      isAdminOf(businessId) ||
                      (request.auth.uid == uid &&
                       'invitationId' in request.resource.data &&
                       isValidPendingInvitation(request.resource.data.invitationId, uid, businessId)) ||
                      isSuperAdmin()
                    );

      // 수정: 사업주(BUSINESS_ADMIN)·슈퍼어드민만 (권한 변경)
      // [RULE-FIX-L6] isSubAdminOf 추가됐으나 SEC-SUBADMIN-ESC로 제거 — 권한 상승 차단
      // SEC-SUBADMIN-ESC: SubAdmin이 자신보다 높은 permissions를 타 SubAdmin에게 부여 가능
      //   → isAdminOf(businessId)(사업주)·isSuperAdmin()만 허용으로 제한
      // [SEC-M7] permissions 필드만 허용 — 관리자가 name/phone/addedAt 등 식별 필드를 임의 수정하는 공격 차단
      allow update: if isLoggedIn() && (
                      isSuperAdmin() ||
                      (isAdminOf(businessId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['permissions']))
                    );

      // 삭제: 해당 사업장 관리자 · 본인(자진 탈퇴) · 슈퍼어드민
      allow delete: if isLoggedIn() && (
                      isAdminOf(businessId) ||
                      request.auth.uid == uid ||
                      isSuperAdmin()
                    );
    }

    // ═══════════════════════════════════════════════════════════
    // payroll_summaries 컬렉션 (급여 월별 집계)
    // ═══════════════════════════════════════════════════════════
    match /payroll_summaries/{summaryId} {

      // get: 해당 사업장 관리자·하위 관리자·슈퍼어드민 (resource==null: 문서 미존재 허용)
      allow get: if isLoggedIn() && (
                   resource == null ||
                   isAdminOf(resource.data.businessId) ||
                   isSubAdminOf(resource.data.businessId) ||
                   isSuperAdmin()
                 );
      // list: [RULE-FIX-CF 2026-07-13] callableGetPayrollSummaries CF 이전 완료
      //   → 일반 관리자는 CF(Admin SDK) 경유, 직접 list는 슈퍼어드민만 허용
      //   isBusinessAdmin()/isSubAdmin() 제거: CF가 assertBizAdmin으로 교차검증 수행
      allow list: if isSuperAdmin();

      // 쓰기: Cloud Functions Admin SDK만 허용 (클라이언트 직접 쓰기 차단)
      // Admin SDK는 Firestore 규칙 우회 → 클라이언트는 항상 거부
      allow write: if false;

      // workers 서브컬렉션 — 근무자별 월급 상세 (1MB 한계 회피 구조)
      match /workers/{workerId} {
        // 읽기: 해당 사업장 관리자·하위 관리자·슈퍼어드민
        // [NULL-CRASH-FIX 2026-07-16] 부모 문서 미존재 시 get().data 접근 → null crash → PERMISSION_DENIED
        //   isPayrollSummaryAdmin() 헬퍼로 분리 후 null 체크 선행 (isToAdmin() 동일 패턴)
        allow get, list: if isLoggedIn() && (
          isSuperAdmin() ||
          isPayrollSummaryAdmin(summaryId)
        );
        // 쓰기: CF Admin SDK 전담
        allow write: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // deleted_accounts 컬렉션 (탈퇴 계정 기록 — 재가입 제한용)
    // ═══════════════════════════════════════════════════════════
    match /deleted_accounts/{docId} {
      // 읽기: 슈퍼어드민만 (원본 복구·블랙리스트 관리용)
      allow read: if isSuperAdmin();

      // 쓰기(추가): recordDeletedAccount CF(Admin SDK)가 전담 — 클라이언트 직접 쓰기 완전 차단
      // [AUTH-H2] Admin SDK는 Firestore 규칙 우회 → 클라이언트는 항상 거부
      allow create: if false;

      // [HIGH-FIX 29차] update: if false — 재가입 차단 기록(phone/ci/ciHash) 슈퍼어드민도 직접 수정 차단
      //   기록 조작 시 CF callableRegister의 중복 차단 로직 우회 가능
      //   운영 수정 필요 시 CF Admin SDK 경유 전용
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // pending_token_revocations 컬렉션 (세션 무효화 실패 재처리 큐 — CF 내부용)
    // ═══════════════════════════════════════════════════════════
    match /pending_token_revocations/{docId} {
      // CF Admin SDK(masterScheduler retry)만 읽기·쓰기 — 클라이언트 접근 완전 차단
      // uid, reason, callerUid 등 개인정보가 포함되므로 클라이언트 접근 차단 필수
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // _processedWageEvents 컬렉션 (임금 이벤트 멱등성 체크 — CF 내부용)
    // ═══════════════════════════════════════════════════════════
    match /_processedWageEvents/{eventId} {
      // [SEC-01 수정] 보안 규칙 누락으로 인증된 사용자가 읽을 수 있던 취약점 차단.
      // 이 컬렉션은 onAttendanceWageChanged CF 가 event.id 중복 처리를 방지하기 위한 내부 저장소.
      // Admin SDK는 규칙 우회 → 클라이언트 접근만 차단.
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // passwordResetCodes 컬렉션 (비밀번호 재설정 인증코드)
    // ═══════════════════════════════════════════════════════════
    match /passwordResetCodes/{username} {
      // Cloud Functions(Admin SDK)만 읽기·쓰기 (클라이언트 접근 차단)
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // payment_change_requests 컬렉션 (지급방식 변경 요청)
    // ═══════════════════════════════════════════════════════════
    match /payment_change_requests/{reqId} {
      // get: 요청자 본인 · 해당 사업장 관리자/하위관리자 · 슈퍼어드민
      // [HIGH-FIX] SubAdmin 누락: 급여 대시보드에서 SubAdmin이 변경요청 단건 조회 → PERMISSION_DENIED
      allow get: if isLoggedIn() && (
                    resource == null ||
                    isOwner(resource.data.workerId) ||
                    isAdminOf(resource.data.businessId) ||
                    isSubAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );
      // list: [크로스-사업장 방지] 관리자는 소속 사업장 businessId 필터 필수
      //   · USER는 get으로 개별 접근 (list는 타인 급여 데이터 노출 위험)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getPaymentChangeRequestsByBusiness: .where('businessId', isEqualTo: businessId)
      //   · SubAdmin: 동일 패턴
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      // [RULE-FIX-CF 2026-07-13] callableGetPaymentChangeRequests CF 이전 완료 — 슈퍼어드민만 허용
      allow list: if isSuperAdmin();
      // 생성: 본인 workerId이거나 해당 사업장 관리자/하위관리자 (타인 명의 위조 방지)
      // [HIGH-FIX] SubAdmin 누락: SubAdmin도 지급방식 변경 처리 가능 → isSubAdminOf 추가
      // [SEC-FIX] workerId == auth.uid 경로: businessId가 본인 소속 사업장인지 검증
      //   → 근무자가 타 사업장 ID를 businessId에 입력해 위조 요청 생성하는 것을 차단
      // [MED-BYPASS-FIX] businessId != '' 조건 추가 — 미소속(빈 문자열) 사용자의 '' == '' bypass 차단
      // [SEC-84] USER 경로: status='PENDING' 강제 — 클라이언트가 status='APPROVED'로 직접 생성하는 취약점 차단
      allow create: if isLoggedIn() && (
                    // [LOW-FIX] 필드 화이트리스트 — processedBy/processedAt/rejectReason create 차단
                    request.resource.data.keys().hasOnly([
                      'applicationId', 'businessId', 'businessName', 'workerId', 'workerName',
                      'currentPayScheduleType', 'currentPayScheduleDay',
                      'requestedPayScheduleType', 'requestedPayScheduleDay',
                      'requestReason', 'effectiveFrom', 'status', 'createdAt', 'updatedAt'
                    ]) &&
                    // [TS-FIX 2026-07-16] createdAt/updatedAt 서버타임스탬프 강제 — 소급 날짜 주입 차단
                    // CREATE 컨텍스트에서 resource.data가 null이므로 diff() 대신 'in' 연산자 사용
                    (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time) &&
                    (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
                  ) && (
                    (request.resource.data.workerId == request.auth.uid &&
                     request.resource.data.businessId != '' &&
                     request.resource.data.get('status', '') == 'PENDING' &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ==
                     request.resource.data.businessId) ||
                    // [RULE-FIX-M3] 관리자 경로도 status='PENDING' 강제 — 승인 이력 우회 차단
                    ((isAdminOf(request.resource.data.businessId) ||
                      isSubAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()) &&
                     request.resource.data.get('status', '') == 'PENDING')
                  );
      // 수정: 해당 사업장 관리자/하위관리자 · 슈퍼어드민 (승인/거절)
      // SEC-61: 상태 전이 검증 (PENDING → APPROVED/REJECTED만), 필드 화이트리스트
      //   → 이미 처리된 요청 재처리 차단, 임의 필드 덮어쓰기 차단
      // [V10-FIX] processedBy 호출자 UID 검증 — 슈퍼어드민도 동일 제약 적용
      //   isSuperAdmin() bypass 제거: 감사 추적 필드 위조 차단
      allow update: if isLoggedIn() && (
                    isAdminOf(resource.data.businessId) ||
                    isSubAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  ) && (
                    resource.data.status == 'PENDING' &&
                    (request.resource.data.status == 'APPROVED' ||
                     request.resource.data.status == 'REJECTED') &&
                    request.resource.data.processedBy == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'processedBy', 'processedAt',
                                'rejectReason', 'updatedAt'])
                  );
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // interim_settlement_requests 컬렉션 (중간정산 요청)
    // ═══════════════════════════════════════════════════════════
    match /interim_settlement_requests/{reqId} {
      // get: 요청자 본인 · 해당 사업장 관리자/하위관리자 · 슈퍼어드민
      // [CRITICAL-FIX] SubAdmin 누락: payroll_worker_detail_screen에서 SubAdmin이 중간정산 실행 시
      //                createInterimSettlementRequest → get → 연달아 PERMISSION_DENIED 발생
      allow get: if isLoggedIn() && (
                    resource == null ||
                    isOwner(resource.data.workerId) ||
                    isAdminOf(resource.data.businessId) ||
                    isSubAdminOf(resource.data.businessId) ||
                    isSuperAdmin()
                  );
      // list: [크로스-사업장 방지] 관리자는 소속 사업장 businessId 필터 필수
      //   · USER는 get으로 개별 접근 (list는 타인 급여 데이터 노출 위험)
      //   · BUSINESS_ADMIN: isAdminOf(businessId) 필터 필수
      //     - getInterimSettlementsByBusiness: .where('businessId', isEqualTo: businessId)
      //   · SubAdmin: 동일 패턴
      // [BUGFIX] 복합 equality 쿼리에서 request.query.filters 미노출 대비 user.businessId 폴백
      // [RULE-FIX-CF 2026-07-13] callableGetInterimSettlements CF 이전 완료 — 슈퍼어드민만 허용
      allow list: if isSuperAdmin();
      // 생성: 본인 workerId이거나 해당 사업장 관리자/하위관리자
      // [CRITICAL-FIX] SubAdmin 누락: createInterimSettlementRequest → PERMISSION_DENIED
      // [SEC-FIX] workerId == auth.uid 경로: businessId가 본인 소속 사업장인지 검증
      //   → 근무자가 타 사업장 ID를 businessId에 입력해 급여 관련 위조 요청 생성하는 것을 차단
      // [MED-BYPASS-FIX] businessId != '' 조건 추가 — 미소속(빈 문자열) 사용자의 '' == '' bypass 차단
      // [SEC-85] USER 경로: status='PENDING' 강제 — 클라이언트가 status='PROCESSED'로 직접 생성하는 취약점 차단
      allow create: if isLoggedIn() && (
                    // [LOW-FIX] 필드 화이트리스트 — processedBy/processedAt/transferNote/rejectReason create 차단
                    request.resource.data.keys().hasOnly([
                      'applicationId', 'businessId', 'businessName', 'workerId', 'workerName',
                      'periodStart', 'periodEnd', 'attendanceIds',
                      'requestedAmount', 'netAmount', 'requestReason',
                      'status', 'createdAt', 'updatedAt'
                    ]) &&
                    // [TS-FIX 2026-07-16] createdAt/updatedAt 서버타임스탬프 강제 — 소급 날짜 주입 차단
                    // CREATE 컨텍스트에서 resource.data가 null이므로 diff() 대신 'in' 연산자 사용
                    (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time) &&
                    (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
                  ) && (
                    (request.resource.data.workerId == request.auth.uid &&
                     request.resource.data.businessId != '' &&
                     request.resource.data.get('status', '') == 'PENDING' &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ==
                     request.resource.data.businessId) ||
                    // [RULE-FIX-M4] 관리자 경로도 status='PENDING' 강제 — 처리 이력 우회 차단
                    ((isAdminOf(request.resource.data.businessId) ||
                      isSubAdminOf(request.resource.data.businessId) ||
                      isSuperAdmin()) &&
                     request.resource.data.get('status', '') == 'PENDING')
                  );
      // [CRITICAL-FIX] SubAdmin 누락: approveInterimSettlement → PERMISSION_DENIED
      // [SEC-52] PENDING 상태에서만 처리 허용 + 허용 필드 화이트리스트
      //   — REJECTED → APPROVED 역변조 차단 (상태 전이 무결성 보장)
      // [V10-FIX] processedBy 호출자 UID 검증 추가
      allow update: if isLoggedIn() &&
                    (isAdminOf(resource.data.businessId) ||
                     isSubAdminOf(resource.data.businessId) ||
                     isSuperAdmin()) &&
                    resource.data.status == 'PENDING' &&
                    (request.resource.data.status == 'PROCESSED' ||
                     request.resource.data.status == 'APPROVED' ||
                     request.resource.data.status == 'REJECTED') &&
                    request.resource.data.processedBy == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'processedBy', 'processedAt',
                                'rejectReason', 'transferNote', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // SMS 인증 코드 — Cloud Functions Admin SDK만 접근 (클라이언트 차단)
    // 전화번호가 문서 ID이므로 외부 노출 방지
    // ═══════════════════════════════════════════════════════════
    match /sms_verifications/{phone} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 이메일 인증 코드 — Cloud Functions Admin SDK만 접근
    // ═══════════════════════════════════════════════════════════
    match /emailVerificationCodes/{email} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PASS 본인인증 토큰 — Cloud Functions Admin SDK만 접근 (CF verifyPassAuth)
    // [BUG-FR-01 수정] 명시적 차단 규칙 추가 — 미명시 시 향후 rules 변경으로 의도치 않게 열릴 위험
    // ═══════════════════════════════════════════════════════════
    match /passTokens/{token} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 앱 설정 (약관 등) — 읽기: 로그인 사용자, 쓰기: 슈퍼관리자만
    // legal_terms는 회원가입 화면에서 비인증 상태로 읽으므로 공개 허용
    // ═══════════════════════════════════════════════════════════
    match /app_settings/{docId} {
      allow read: if docId == 'legal_terms' || isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // id_card_copy_logs — 주민번호 복사 감사 로그 (개인정보보호법 접근 기록)
    //   · create: 로그인한 관리자/서브어드민만, viewerId == auth.uid 검증
    //   · read: 슈퍼어드민만 (감사 목적)
    //   · update/delete: 전면 차단 (감사 로그 불변 보장)
    // ═══════════════════════════════════════════════════════════
    match /id_card_copy_logs/{logId} {
      // [SEC-FIX] businessId 검증 추가: 관리자가 소속 사업장 외 열람 기록을 위조하는 것을 차단
      // 개인정보보호법상 주민번호 열람 감사 로그는 실제 소속 사업장 기록이어야 함
      // [특이사항] isSuperAdmin() 추가: SUPER_ADMIN이 foreign_worker_approval_screen에서
      // 신분증 이미지를 열람할 때 감사 로그 기록이 가능하도록 허용.
      // businessId == '' (빈 문자열)로 기록하여 사업장 귀속 없음을 명시한다.
      // [SEC-ACTION] action 화이트리스트: 감사 로그 위변조 차단
      //   클라이언트가 임의 action 값을 써서 실제 없는 행위를 기록하거나
      //   열람 행위를 'did_not_view' 같은 값으로 숨기는 것을 차단.
      allow create: if isLoggedIn() &&
                      request.resource.data.viewerId == request.auth.uid &&
                      request.resource.data.action in ['resident_number_copy', 'view_id_card_image'] &&
                      // [RULE-LOG-TIMESTAMP] 개인정보보호법상 열람 일시 위변조 차단
                      //   신분증 열람 감사 로그는 정확한 접근 시점이 법적 요건
                      (!('createdAt' in request.resource.data) ||
                       request.resource.data.createdAt == request.time) &&
                      (isAdminOf(request.resource.data.businessId) ||
                       isSubAdminOf(request.resource.data.businessId) ||
                       isSuperAdmin());
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 컬렉션: 명시적 차단
    // SEC-75: Firestore 기본 동작(미명시=차단)에 의존하지 않고
    //         명시적 와일드카드 규칙으로 향후 버전 변경 대비
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
