rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 일반 이미지: 5MB 제한
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // [SEC-ST01] 이미지 MIME 타입 제한 — HTML/JS 등 악성 파일 업로드 차단
    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // 계약서 PDF: 10MB 제한
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/ — 사업장 이미지 (대표, 추가, 업무유형)
    // ═══════════════════════════════════════════════════════════
    // [STORAGE-RULE-NOTE] Firebase Storage 규칙 내 firestore.get() 호출이 이 프로젝트에서
    // 동작하지 않는 것이 실험으로 확인됨 (isLoggedIn()만으로 진단 시 성공).
    // isBusinessAdmin(businessId) 등 Firestore 읽기 기반 함수 전부 제거.
    //
    // create/update 보안:
    // - 로그인 + 5MB 제한 → 미인증 업로드 차단
    // - businesses/{businessId} 경로의 businessId는 20자 무작위 ID → 외부 추측 불가
    // - 사업장 이미지는 민감 데이터 아님 (신분증·계약서는 users/, contracts/ 경로 분리)
    //
    // delete 보안:
    // - 로그인 필수, UI 레벨에서 ownerId만 삭제 버튼 노출
    //
    // list 보안:
    // - 앱 코드에서 businesses/ 경로에 listAll() 미사용 → false로 차단
    match /businesses/{businessId}/{allPaths=**} {
      allow get: if isLoggedIn();
      allow list: if false;
      // [SEC-ST01] isImageType(): MIME 타입 검증 — HTML/JS 업로드 차단
      allow create, update: if isLoggedIn() && isUnder5MB() && isImageType();
      // [LOW-STORAGE] 클라이언트 직접 삭제 차단 — callableDeleteBusinessImage CF(Admin SDK)로만 허용
      // Storage rules에서 Firestore 읽기 불가(프로젝트 특이사항)이므로 소속 검증을 CF에서 처리
      allow delete: if false;
    }

    // ── users/ — 신분증·통장·사업자등록증 (민감 파일) ───────────
    // 본인만 읽기·쓰기·삭제 허용 — Firestore 읽기 불필요 (uid 직접 비교)
    // request.resource == null: read/delete 시 incoming resource 없음 → 크기 체크 면제
    // [SEC-ST01] 업로드 시 이미지 MIME 타입만 허용
    //
    // [SIGNED-URL-AUDIT] 신분증(idCardImageUrl) Signed URL → 이미 구현 완료
    //   callableGetIdCardSignedUrl CF: idCardAccessRequests 승인 확인 후 1시간 만료 URL 반환.
    //   통장/사업자등록증 URL은 callableGetUsersBatch에서 응답 필드 제거로 노출 차단.
    //   Firestore rules도 users/{uid} 문서를 본인·소속 관리자·슈퍼어드민만 읽을 수 있도록 제한.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    match /users/{uid}/{allPaths=**} {
      allow read, delete:
          if isLoggedIn() && request.auth.uid == uid;
      allow create, update:
          if isLoggedIn() && request.auth.uid == uid &&
             isUnder5MB() && isImageType();
    }

    // ── contracts/ — 근로계약서 서명 이미지·완성 PDF ───────────
    // [STORAGE-RULE-NOTE] isContractParty(), isSuperAdminUser() 모두 Firestore 읽기 기반
    // → 동일하게 동작하지 않음. 계약서 파일은 다운로드 URL 토큰 기반 접근으로 운영.
    // 토큰 없이 직접 경로 접근 시도: 로그인 + 10MB 제한만 체크 (URL 토큰이 실질적 보호막)
    // [CS-01] update: if false — 이미 업로드된 서명/PDF 덮어쓰기 완전 차단
    // 로그인된 사용자가 contractId를 알더라도 서명 이미지 오염 불가
    // delete는 Firestore 트랜잭션 실패 시 CF/클라이언트 롤백 흐름에서 필요
    //
    // [SIGNED-URL-AUDIT] 계약서 Signed URL 불필요 — 의도된 설계.
    //   allow read: if false → Storage SDK 직접 경로 차단 (다운로드 URL 토큰만 유효).
    //   계약서 URL은 근로자·고용주 당사자 모두 접근해야 하는 공유 데이터.
    //   Firestore rules의 isContractParty() 가드가 URL 노출 경로를 제한.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    match /contracts/{contractId}/{allPaths=**} {
      // [H-1] 다운로드 URL 토큰으로만 접근 — Storage SDK 직접 경로 차단
      // contract_service.dart에서 getDownloadURL() 반환 URL로만 접근하므로 기능 영향 없음
      allow read: if false;
      allow create: if isLoggedIn() && isUnder10MB();
      allow update: if false;
      // [SEC-CONTRACT-MED] 임의 삭제 차단 — 로그인된 사용자도 계약서 파일 삭제 불가.
      // CF 실패 시 롤백은 callableFinalizeWorkerSignature 내부 _cleanupContractFiles(Admin SDK)에서 전담.
      // 클라이언트 삭제 시도는 이 규칙에 의해 항상 차단됨.
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 경로: 기본 차단
    // ═══════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
