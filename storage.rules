rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/ — 사업장 이미지 (대표, 추가, 업무유형)
    // ═══════════════════════════════════════════════════════════
    // 읽기: 로그인된 사용자
    // 쓰기: 로그인된 사용자 (role 권한은 Firestore 규칙에서 담당)
    match /businesses/{allPaths=**} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ═══════════════════════════════════════════════════════════
    // users/ — 신분증, 통장, 사업자등록증, 회원가입 임시 파일
    // ═══════════════════════════════════════════════════════════
    // 읽기: 로그인된 사용자 (관리자가 서류 확인 필요)
    // 쓰기: 로그인된 사용자
    //   - 일반 경로: users/{uid}/ → 본인만 업로드
    //   - 임시 경로: users/temp_{timestamp}/ → 회원가입 중 업로드
    //     (temp_ 경로는 Storage 규칙에서 부분 문자열 매칭 불가 → 통합 허용)
    match /users/{allPaths=**} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 경로: 기본 차단
    // ═══════════════════════════════════════════════════════════
  }
}
