rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 일반 이미지: 5MB 제한
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // 계약서 PDF: 10MB 제한
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/ — 사업장 이미지 (대표, 추가, 업무유형)
    // ═══════════════════════════════════════════════════════════
    match /businesses/{allPaths=**} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isUnder5MB();
    }

    // ── users/ — 신분증·통장·사업자등록증 (민감 파일) ───────────
    // 읽기: 본인 또는 SUPER_ADMIN만 허용 (관리자 열람은 Firestore id_card_access_requests로 제어)
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isLoggedIn() && isUnder5MB() && (
        request.auth.uid == uid ||
        uid.matches('temp_.*')   // 회원가입 임시 경로
      );
    }

    // ── contracts/ — 근로계약서 서명 이미지·완성 PDF ───────────
    // 읽기: 로그인 사용자만 (계약서는 Firestore workerId/businessId로 앱 레벨 접근 제어)
    match /contracts/{allPaths=**} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isUnder10MB();
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 경로: 기본 차단
    // ═══════════════════════════════════════════════════════════
  }
}
