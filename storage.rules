rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 일반 이미지: 5MB 제한
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // [SEC-ST01] 이미지 MIME 타입 제한 — HTML/JS 등 악성 파일 업로드 차단
    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // 계약서 PDF: 10MB 제한
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/ — 사업장 이미지 (대표, 추가, 업무유형)
    // ═══════════════════════════════════════════════════════════
    // [SEC-BIZ-UPLOAD 2026-07-17] create/update → callableUploadBusinessImage CF 전용
    //   Storage rules에서 Firestore 읽기 불가(프로젝트 특이사항)로 소속 검증 불가.
    //   이전: isLoggedIn()만으로 허용 → TO 목록에서 businessId 획득한 임의 사용자가 덮어쓰기 가능.
    //   이후: CF assertBizAdmin 검증 + Admin SDK 저장 → 소속 사업장 관리자만 업로드 가능.
    //   delete: callableDeleteBusinessImage CF 전용 (기존 유지)

    // ── businesses/{bizId}/license/ — 사업자등록증 전용 (보안 강화) ──
    // [REG-2 SEC 2026-08-20]
    //   일반 사업장 이미지(대표·추가·교통편)와 달리 사업자등록증은 민감 서류.
    //   보안 목표: 일반 USER·무관 ADMIN SDK 직접 접근 차단.
    //   callableUploadBusinessImage(fileType:'businessLicense')로 저장 시
    //   다운로드 토큰 없이 저장 → 토큰 URL 우회 불가.
    //   SUPER_ADMIN 조회: callableGetBusinessLicenseSignedUrl CF → Signed URL (1시간)
    //   Storage rules에서 Firestore 읽기 불가(프로젝트 특이사항)로 role 검증 불가
    //   → allow get: if false (전면 차단). 모든 접근은 CF Admin SDK 경유.
    //
    //   ※ 일반 businesses/{bizId} 하위 이미지와 보안등급을 달리 적용하는 의도.
    //
    // [R8-P5.2 2026-09-21] 위 "더 구체적인 규칙이 우선 적용됨"은 사실이 아니었다.
    //   Storage rules 는 매칭되는 모든 match 블록을 평가해 하나라도 허용하면 허용한다(OR).
    //   license/ 경로는 아래 일반 블록의 {allPaths=**} 에도 매칭되므로,
    //   여기서 read:false 를 선언해도 아래 allow get: isLoggedIn() 이 그대로 열어 줬다.
    //   DEV 런타임에서 무관한 근로자 계정이 남의 등록증을 읽는 것을 확인했다.
    //   → 차단은 "더 구체적인 블록"이 아니라 일반 블록의 조건에서 직접 제외해야 성립한다.
    match /businesses/{businessId}/license/{allPaths=**} {
      allow read: if false;       // SDK 직접 접근 전면 차단 (토큰도 없으므로 URL 접근도 403)
      allow create, update: if false;  // CF Admin SDK 전용
      allow delete: if false;
    }

    // 일반 사업장 이미지 (대표·추가·교통편·업무유형): 로그인 사용자 읽기 허용
    //   [R8-P5.2] {allPaths=**} → {fileName} 단일 세그먼트.
    //   license/ 는 두 세그먼트라 이 블록에 아예 매칭되지 않는다 — OR 합산 경로를 구조로 끊는다.
    //   (조건식으로 제외하려 했으나 allPaths.matches() 평가 실패로 전체 deny 가 되어 되돌렸다)
    //   businesses/{id}/ 아래 더 깊은 경로는 매칭되는 규칙이 없어 기본 거부 — CF Admin SDK 전용.
    match /businesses/{businessId}/{fileName} {
      allow get: if isLoggedIn();
      allow list: if false;
      allow create, update: if false;
      allow delete: if false;
    }

    // ── users/ — 신분증·통장·사업자등록증 (민감 파일) ───────────
    // 본인만 읽기·쓰기·삭제 허용 — Firestore 읽기 불필요 (uid 직접 비교)
    // request.resource == null: read/delete 시 incoming resource 없음 → 크기 체크 면제
    // [SEC-ST01] 업로드 시 이미지 MIME 타입만 허용
    //
    // [SIGNED-URL-AUDIT] 신분증 Signed URL → 구현 완료 (callableGetIdCardSignedUrl CF)
    //   CF에서 idCardAccessRequests 승인 확인 후 1시간 만료 Signed URL 반환.
    //   통장/사업자등록증 URL은 callableGetUsersBatch에서 응답 필드 제거로 노출 차단.
    //   Firestore rules에서 users/{uid} 문서를 본인·슈퍼어드민만 GET 허용 (2026-08-10 관리자 제거).
    //   Storage 직접 경로(SDK)는 아래 규칙에서 본인만 허용; 관리자는 항상 CF 경유.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    // [R7-P4.4E.11C.0B §28~§37] 계정 삭제 write barrier.
    //
    //   `account_deletion_tombstones/{uid}` 가 존재하면 그 UID 의 계정 삭제가
    //   파괴 단계에 진입한 것이므로 **새 bytes 를 만들지 못하게** 한다.
    //   존재만 본다 — 문서 내용을 해석하지 않는다(§5).
    //
    //   [전제] 이 cross-service 조회에는 Firebase Storage service agent 에
    //   `roles/firebaserules.firestoreServiceAgent` 가 필요하다. 없으면
    //   조회가 실패하고 조건이 거짓이 되어 **fail-closed** 된다(§37) —
    //   조회 실패를 "삭제 중 아님"으로 바꾸는 fallback 을 두지 않는다.
    //   DEV 에는 적용돼 있고(R7-P4.4E.11C.0A.1 live verified), PROD 는 별도 확인.
    function accountDeletionBarrierExists(uid) {
      return firestore.exists(
          /databases/(default)/documents/account_deletion_tombstones/$(uid));
    }

    // [FULL13-DOC-INTEGRITY.4] 신분증 객체 — `users/{uid}/idCard_<ms>.<ext>`.
    //   서버 판정·사업장 검토·선택 열람은 이 경로(`users.idCardImagePath`)와 문서 버전으로
    //   사진을 가리킨다. 같은 경로의 바이트가 바뀌면 버전은 그대로인데 가리키는 사진이 바뀐다.
    //   그래서 신분증 객체는 **새로 만들기만** 한다 — 덮어쓰기·메타데이터 변경 금지, 지금
    //   참조 중인 객체는 클라이언트가 지우지 못한다(지운 뒤 같은 경로로 다시 만드는 우회 차단).
    //   정상 교체는 새 경로 업로드 → callableMarkIdCardVerified(거래에서 경로·버전 전환)다.
    //   판정은 객체 이름 문자열(`resource.name`·`request.resource.name`)로 한다 —
    //   재귀 와일드카드 값은 문자열이 아니어서 `.matches` 가 평가 오류가 된다(에뮬레이터 확인).
    function isIdCardName(name) {
      return name.matches('users/[^/]+/idCard_[0-9]{10,}[.](jpg|jpeg|png|webp|heic|heif)');
    }

    // 지금 users 문서가 이 객체를 참조하는가 — 신분증 객체 delete 에서만 평가한다.
    function isCurrentIdCard(uid, name) {
      return firestore.get(/databases/(default)/documents/users/$(uid))
          .data.get('idCardImagePath', '') == name;
    }

    // [DOC-PRODUCT-DELETE.8] 서버가 지우기로 한(정리 대기) 이름 — 다시 만들지 못한다. 그래야 늦게 끝나는
    //   정리가 지우는 generation 이 언제나 정리 대기 전에 있던 그 객체다. users 문서는 위와 같은 문서다
    //   (평가당 서로 다른 문서 수는 그대로).
    function isRetiringIdCard(uid, name) {
      return name in firestore.get(/databases/(default)/documents/users/$(uid))
          .data.get('idDocumentOrphanPaths', []);
    }

    match /users/{uid}/{allPaths=**} {
      // [§30] read 는 바꾸지 않는다. 삭제 중 client delete 는 bytes 를
      //   **줄이는** 쪽이라 고아 경합의 원인이 아니고, 서버 정리는 Admin SDK 라
      //   rules 와 무관하다.
      allow read:
          if isLoggedIn() && request.auth.uid == uid;
      // [DOC-LATE-DELETE.7] 신분증 객체는 클라이언트가 지우지 못한다 — 옛 사진·업로드 실패 정리는
      //   서버가 한다(callableMarkIdCardVerified 의 정리, callableDiscardIdCardUpload, callableDeleteIdCard).
      //   서버는 같은 users 거래에서 '현재 아님'을 확인하고 정리 대기에 올린 뒤에만 지우며, 업로드 판정은
      //   정리 대기 경로를 현재로 받지 않는다. 클라이언트 삭제는 그 순서 밖이라 승인 뒤 늦게 끝날 수 있다.
      //   그 외 파일은 예전과 같다.
      allow delete:
          if isLoggedIn() && request.auth.uid == uid &&
             !isIdCardName(resource.name);
      // [§36] 권한·정책을 먼저 보고 마지막에 barrier 를 본다 — 무권한
      //   요청 때문에 불필요한 cross-service 조회가 일어나지 않도록.
      //   [§39·§40] 이 평가에서 Firestore 접근은 **정확히 1회**다.
      //   [FULL13-DOC-INTEGRITY.4] 같은 이름 업로드가 create 로 평가되는 경우가 있다(에뮬레이터
      //   확인) — 신분증 이름이면 기존 객체가 없을 때만(resource == null) 만든다.
      //   [STORAGE-FINALIZE.5 · S1] 객체가 없어도 **지금 users 가 참조하는 경로**면 만들지 못한다.
      //   참조는 남았는데 객체가 없는 상태(DEV 6명)에서 같은 경로로 새 사진을 만들면 옛 판정·검토를
      //   그대로 물려받는다. 복구는 새 경로 업로드 → 서버 전환(새 버전)으로만 한다.
      //   Firestore 문서 접근: users(get) + tombstone(exists) — 평가당 서로 다른 문서 최대 2개.
      allow create:
          if isLoggedIn() && request.auth.uid == uid &&
             (!isIdCardName(request.resource.name) ||
              (resource == null && !isCurrentIdCard(uid, request.resource.name) &&
               !isRetiringIdCard(uid, request.resource.name))) &&
             isUnder5MB() && isImageType() &&
             !accountDeletionBarrierExists(uid);
      // [FULL13-DOC-INTEGRITY.4] update(같은 이름 덮어쓰기·메타데이터 변경)는 신분증 객체에서
      //   허용하지 않는다. 이름 검사가 barrier 조회보다 먼저다 — 조회 횟수는 그대로 최대 1회.
      allow update:
          if isLoggedIn() && request.auth.uid == uid &&
             !isIdCardName(resource.name) &&
             isUnder5MB() && isImageType() &&
             !accountDeletionBarrierExists(uid);
    }

    // ── contracts/ — 근로계약서 서명 이미지·완성 PDF ───────────
    // [SIGNED-URL-AUDIT] 계약서 Signed URL 불필요 — 의도된 설계.
    //   allow read: if false → Storage SDK 직접 경로 차단 (다운로드 URL 토큰만 유효).
    //   Firestore rules의 isContractParty() 가드가 URL 노출 경로를 제한.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    //
    // [MED-FIX] 파일별 업로드 당사자 검증:
    // - signature_employer.png: 신규 계약서 초안 케이스에서 Firestore 문서 미존재 가능
    //   → contractId 무작위성 + update: if false(덮어쓰기 차단)에 의존
    // - signature_worker.png / contract.pdf: employer 서명 완료 후 Firestore 문서 존재 보장
    //   → firestore.get()으로 workerId 교차검증, 명시되지 않은 파일 업로드 차단
    match /contracts/{contractId}/{allPaths=**} {
      allow read: if false;
      // create는 아래 파일별 규칙에서 처리 — 명시되지 않은 경로 업로드 자동 차단
      allow update: if false;
      // [SEC-CONTRACT-MED] 임의 삭제 차단.
      // CF 실패 시 롤백은 callableFinalizeWorkerSignature 내부 _cleanupContractFiles(Admin SDK) 전담.
      allow delete: if false;
    }
    // [SEC-EMPLOYER-SIG 2026-07-15] callableFinalizeEmployerSignature CF(Admin SDK)로 완전 이전.
    //   CF에서 assertBizAdmin 소속 검증 + Storage 업로드 원자 처리.
    //   클라이언트 직접 업로드 경로 if false로 완전 차단.
    match /contracts/{contractId}/signature_employer.png {
      allow create: if false;
    }
    // worker 서명·PDF: callableFinalizeWorkerSignature CF(Admin SDK)가 전담.
    // [STORAGE-RULE-NOTE] firestore.get()은 이 프로젝트에서 작동하지 않는 것으로 실험 확인.
    // → 근무자가 CF를 우회해 직접 업로드하는 경로 차단 + employer와 일관성 유지.
    match /contracts/{contractId}/signature_worker.png {
      allow create: if false;
    }
    match /contracts/{contractId}/contract.pdf {
      allow create: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 경로: 기본 차단
    // ═══════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
