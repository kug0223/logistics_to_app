rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 일반 이미지: 5MB 제한
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // [SEC-ST01] 이미지 MIME 타입 제한 — HTML/JS 등 악성 파일 업로드 차단
    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // 계약서 PDF: 10MB 제한
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════
    // businesses/ — 사업장 이미지 (대표, 추가, 업무유형)
    // ═══════════════════════════════════════════════════════════
    // [SEC-BIZ-UPLOAD 2026-07-17] create/update → callableUploadBusinessImage CF 전용
    //   Storage rules에서 Firestore 읽기 불가(프로젝트 특이사항)로 소속 검증 불가.
    //   이전: isLoggedIn()만으로 허용 → TO 목록에서 businessId 획득한 임의 사용자가 덮어쓰기 가능.
    //   이후: CF assertBizAdmin 검증 + Admin SDK 저장 → 소속 사업장 관리자만 업로드 가능.
    //   delete: callableDeleteBusinessImage CF 전용 (기존 유지)

    // ── businesses/{bizId}/license/ — 사업자등록증 전용 (보안 강화) ──
    // [REG-2 SEC 2026-08-20]
    //   일반 사업장 이미지(대표·추가·교통편)와 달리 사업자등록증은 민감 서류.
    //   보안 목표: 일반 USER·무관 ADMIN SDK 직접 접근 차단.
    //   callableUploadBusinessImage(fileType:'businessLicense')로 저장 시
    //   다운로드 토큰 없이 저장 → 토큰 URL 우회 불가.
    //   SUPER_ADMIN 조회: callableGetBusinessLicenseSignedUrl CF → Signed URL (1시간)
    //   Storage rules에서 Firestore 읽기 불가(프로젝트 특이사항)로 role 검증 불가
    //   → allow get: if false (전면 차단). 모든 접근은 CF Admin SDK 경유.
    //
    //   ※ 일반 businesses/{bizId} 하위 이미지와 보안등급을 달리 적용하는 의도.
    //   ※ 이 규칙이 더 구체적이므로 아래 일반 규칙보다 우선 적용됨.
    match /businesses/{businessId}/license/{allPaths=**} {
      allow read: if false;       // SDK 직접 접근 전면 차단 (토큰도 없으므로 URL 접근도 403)
      allow create, update: if false;  // CF Admin SDK 전용
      allow delete: if false;
    }

    // 일반 사업장 이미지 (대표·추가·교통편·업무유형): 로그인 사용자 읽기 허용
    match /businesses/{businessId}/{allPaths=**} {
      allow get: if isLoggedIn();
      allow list: if false;
      allow create, update: if false;
      allow delete: if false;
    }

    // ── users/ — 신분증·통장·사업자등록증 (민감 파일) ───────────
    // 본인만 읽기·쓰기·삭제 허용 — Firestore 읽기 불필요 (uid 직접 비교)
    // request.resource == null: read/delete 시 incoming resource 없음 → 크기 체크 면제
    // [SEC-ST01] 업로드 시 이미지 MIME 타입만 허용
    //
    // [SIGNED-URL-AUDIT] 신분증 Signed URL → 구현 완료 (callableGetIdCardSignedUrl CF)
    //   CF에서 idCardAccessRequests 승인 확인 후 1시간 만료 Signed URL 반환.
    //   통장/사업자등록증 URL은 callableGetUsersBatch에서 응답 필드 제거로 노출 차단.
    //   Firestore rules에서 users/{uid} 문서를 본인·슈퍼어드민만 GET 허용 (2026-08-10 관리자 제거).
    //   Storage 직접 경로(SDK)는 아래 규칙에서 본인만 허용; 관리자는 항상 CF 경유.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    match /users/{uid}/{allPaths=**} {
      allow read, delete:
          if isLoggedIn() && request.auth.uid == uid;
      allow create, update:
          if isLoggedIn() && request.auth.uid == uid &&
             isUnder5MB() && isImageType();
    }

    // ── contracts/ — 근로계약서 서명 이미지·완성 PDF ───────────
    // [SIGNED-URL-AUDIT] 계약서 Signed URL 불필요 — 의도된 설계.
    //   allow read: if false → Storage SDK 직접 경로 차단 (다운로드 URL 토큰만 유효).
    //   Firestore rules의 isContractParty() 가드가 URL 노출 경로를 제한.
    //   → 추가 Signed URL 불필요. 재탐색 금지.
    //
    // [MED-FIX] 파일별 업로드 당사자 검증:
    // - signature_employer.png: 신규 계약서 초안 케이스에서 Firestore 문서 미존재 가능
    //   → contractId 무작위성 + update: if false(덮어쓰기 차단)에 의존
    // - signature_worker.png / contract.pdf: employer 서명 완료 후 Firestore 문서 존재 보장
    //   → firestore.get()으로 workerId 교차검증, 명시되지 않은 파일 업로드 차단
    match /contracts/{contractId}/{allPaths=**} {
      allow read: if false;
      // create는 아래 파일별 규칙에서 처리 — 명시되지 않은 경로 업로드 자동 차단
      allow update: if false;
      // [SEC-CONTRACT-MED] 임의 삭제 차단.
      // CF 실패 시 롤백은 callableFinalizeWorkerSignature 내부 _cleanupContractFiles(Admin SDK) 전담.
      allow delete: if false;
    }
    // [SEC-EMPLOYER-SIG 2026-07-15] callableFinalizeEmployerSignature CF(Admin SDK)로 완전 이전.
    //   CF에서 assertBizAdmin 소속 검증 + Storage 업로드 원자 처리.
    //   클라이언트 직접 업로드 경로 if false로 완전 차단.
    match /contracts/{contractId}/signature_employer.png {
      allow create: if false;
    }
    // worker 서명·PDF: callableFinalizeWorkerSignature CF(Admin SDK)가 전담.
    // [STORAGE-RULE-NOTE] firestore.get()은 이 프로젝트에서 작동하지 않는 것으로 실험 확인.
    // → 근무자가 CF를 우회해 직접 업로드하는 경로 차단 + employer와 일관성 유지.
    match /contracts/{contractId}/signature_worker.png {
      allow create: if false;
    }
    match /contracts/{contractId}/contract.pdf {
      allow create: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 명시되지 않은 경로: 기본 차단
    // ═══════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
