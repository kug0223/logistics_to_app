# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 릴리즈 서명 키 (절대 커밋 금지)
/android/key.properties
/android/app/*.jks
/android/app/*.keystore


# VSCode 실행 설정 (암호화 키 포함 - GitHub 업로드 금지!)
.vscode/launch.json
# 빌드 스크립트 (키 하드코딩 방지)
build_release.bat
build_release.sh
*.env.local

# Firebase 설정 (API 키 포함 — 공개 레포 업로드 금지)
# flutter pub run flutterfire_cli:flutterfire configure 로 재생성 가능
lib/firebase_options.dart
lib/firebase_options_dev.dart
lib/firebase_options_prod.dart
google-services.json
GoogleService-Info.plist

# 환경별 Firebase 설정 디렉토리 (API 키 포함)
config/dev/
config/prod/

# Firebase 서비스 계정 키 (절대 커밋 금지)
functions/*-adminsdk-*.json
functions/service-account-key.json
