    <application>
        <!-- App Check 디버그 토큰 — debug 빌드 전용, 릴리즈에는 포함되지 않음 -->
        <meta-data
            android:name="com.google.firebase.appcheck.debug.token"
            android:value="01a289b7-e33b-4a94-8d90-0dbc3990f74a" />
    </application>
</manifest>
